<Window x:Class="LensDocsStudio.Native.ContentCatalogueWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Templates and snippets" Width="980" Height="730" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="Start with a template" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <TextBlock Text="Project documentation, release notes, requirements and Mermaid diagrams. Adjust the details and review the source before creating a document." TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="Kind" SelectionChanged="FilterChanged" AutomationProperties.Name="Content type" AutomationProperties.AutomationId="CatalogueKind">
    <ComboBoxItem Content="Document templates"/><ComboBoxItem Content="Snippets"/>
   </ComboBox>
   <ComboBox x:Name="Category" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Template category" AutomationProperties.AutomationId="CatalogueCategory"/>
   <DockPanel Grid.Column="2" Margin="10,0,0,0"><Label x:Name="FindLabel" Content="_Find" Target="{Binding ElementName=Filter}"/><TextBox x:Name="Filter" TextChanged="FilterChanged" Padding="6" AutomationProperties.Name="Find template or snippet" AutomationProperties.AutomationId="CatalogueFilter"/></DockPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="185"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*" MinWidth="280"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Entries" SelectionChanged="SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Templates and snippets" AutomationProperties.AutomationId="CatalogueEntries">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" AutomationProperties.Name="Resize template preview"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="FieldsScroll" MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10"><StackPanel x:Name="Fields"/></ScrollViewer>
    <TextBox x:Name="Preview" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" FontFamily="Consolas" FontSize="13" AutomationProperties.Name="Generated source preview" AutomationProperties.AutomationId="CataloguePreview"/>
   </Grid>
  </Grid>
  <ScrollViewer Grid.Row="3" MaxHeight="64" VerticalScrollBarVisibility="Auto" Margin="0,12"><TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="CatalogueStatus"/></ScrollViewer>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Padding="12,6" Margin="0,0,8,0"/>
   <Button x:Name="UseButton" Content="Create document" IsDefault="True" Click="UseSelected" Padding="12,6" AutomationProperties.AutomationId="UseCatalogueEntry"/>
  </StackPanel>
 </Grid>
</Window>
