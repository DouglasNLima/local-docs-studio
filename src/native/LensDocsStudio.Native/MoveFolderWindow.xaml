<Window x:Class="LensDocsStudio.Native.MoveFolderWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Review folder move" Width="760" Height="620" MinWidth="560" MinHeight="460" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Review the folder and link changes" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBlock x:Name="MoveSummary" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.AutomationId="FolderMoveSummary"/>
  <CheckBox x:Name="UpdateLinks" Grid.Row="2" Content="Update internal links and local image references" IsChecked="True" Margin="0,0,0,12" AutomationProperties.AutomationId="UpdateFolderLinks"/>
  <ListBox x:Name="AffectedDocuments" Grid.Row="3" AutomationProperties.Name="Documents in the folder move review" AutomationProperties.AutomationId="FolderMoveDocuments" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4"/></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <ScrollViewer Grid.Row="4" MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,12">
   <TextBlock x:Name="Warnings" TextWrapping="Wrap" AutomationProperties.AutomationId="FolderMoveWarnings"/>
  </ScrollViewer>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/>
   <Button Content="Move folder" IsDefault="True" Click="Apply" Padding="14,6" AutomationProperties.AutomationId="ApplyFolderMove"/>
  </StackPanel>
 </Grid>
</Window>
