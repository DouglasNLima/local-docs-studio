<Window x:Class="LensDocsStudio.Native.DiagramWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:LensDocsStudio.Native.Controls"
 Title="Rendered preview" Width="1000" Height="750" MinWidth="500" MinHeight="350" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="DiagramWindow"
 Icon="Resources/Brand/application.ico" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" PreviewKeyDown="DiagramKeyDown" PreviewKeyUp="DiagramKeyUp" Loaded="FitDiagram">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Resources/CommandIcons.xaml"/><ResourceDictionary Source="Resources/DesktopStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 </ResourceDictionary></Window.Resources>
 <DockPanel>
  <ToolBar DockPanel.Dock="Top" Style="{StaticResource Desktop.DiagramToolbar}" AutomationProperties.Name="Diagram commands">
   <Button Content="Fit diagram" Click="FitDiagram" ToolTip="Fit to Window (F)" AutomationProperties.AutomationId="DiagramFit"/>
   <Button Content="Fit width" Click="FitWidth" ToolTip="Fit the diagram width" AutomationProperties.AutomationId="DiagramFitWidth"/>
   <Button Content="100%" Click="ActualSize" ToolTip="Actual Size (Ctrl+0)" AutomationProperties.AutomationId="DiagramActualSize"/>
   <Button Content="Reset" Click="ResetView" ToolTip="Reset View (Home)" AutomationProperties.AutomationId="DiagramReset"/>
   <Slider x:Name="Zoom" Minimum="1" Maximum="400" Value="100" Width="180" ValueChanged="ZoomChanged" VerticalAlignment="Center" AutomationProperties.Name="Diagram zoom percentage" AutomationProperties.AutomationId="DiagramZoom"/>
   <TextBlock x:Name="ZoomLabel" Text="100%" Width="55" Margin="8,0" VerticalAlignment="Center" AutomationProperties.AutomationId="DiagramZoomLabel"/>
   <Button Content="Copy image" Click="CopyImage" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="DiagramCopyImage"/>
   <Button Content="SVG…" Tag="SVG" Click="Export" Padding="12,6" Margin="0,0,8,0"/>
   <Button Content="PNG…" Tag="PNG" Click="Export" Padding="12,6"/>
  </ToolBar>
  <TextBlock x:Name="DiagramStatus" DockPanel.Dock="Bottom" Margin="16,10" Text="Space+drag or middle-button drag to pan. Ctrl+mouse wheel zooms around the pointer. F fits; Home resets." TextWrapping="Wrap" AutomationProperties.AutomationId="DiagramCopyStatus"/>
  <ScrollViewer x:Name="DiagramScroll" Focusable="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="DiagramMouseWheel" PreviewMouseDown="PanStarted" PreviewMouseMove="PanMoved" PreviewMouseUp="PanFinished" LostMouseCapture="PanCaptureLost" Padding="24" Background="{DynamicResource WindowBrush}" AutomationProperties.AutomationId="DiagramViewport" AutomationProperties.Name="Diagram viewport">
   <Image x:Name="DiagramImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Mermaid diagram drawing">
    <Image.LayoutTransform><ScaleTransform x:Name="DiagramScale" ScaleX="1" ScaleY="1"/></Image.LayoutTransform>
   </Image>
  </ScrollViewer>
 </DockPanel>
</Window>
