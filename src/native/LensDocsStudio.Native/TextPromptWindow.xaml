<Window x:Class="LensDocsStudio.Native.TextPromptWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="640" SizeToContent="Height" MinWidth="440" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="22">
  <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBox x:Name="Input" Padding="8" AutomationProperties.Name="Workspace relative path" AutomationProperties.AutomationId="WorkspacePathInput"/>
  <TextBlock x:Name="Hint" Text="Use a path relative to the open workspace, such as docs/guide.md." TextWrapping="Wrap" Margin="0,8,0,14"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/>
   <Button x:Name="AcceptButton" Content="Continue" IsDefault="True" Click="Accept" Padding="14,6" AutomationProperties.AutomationId="ConfirmWorkspacePath"/>
  </StackPanel>
 </StackPanel>
</Window>
