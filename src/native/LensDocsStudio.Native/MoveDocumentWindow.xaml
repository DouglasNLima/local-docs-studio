<Window x:Class="LensDocsStudio.Native.MoveDocumentWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Review document move" Width="680" Height="510" MinWidth="460" MinHeight="400" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Review the file and link changes" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBlock x:Name="MoveSummary" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,14"/>
  <CheckBox x:Name="UpdateLinks" Grid.Row="2" Content="Update internal links and keep local image references valid" IsChecked="True" Margin="0,0,0,12" AutomationProperties.AutomationId="UpdateMovedLinks"/>
  <ListBox x:Name="AffectedDocuments" Grid.Row="3" AutomationProperties.Name="Documents with planned link changes"/>
  <TextBlock x:Name="Warnings" Grid.Row="4" TextWrapping="Wrap" Margin="0,10,0,12" MaxHeight="100"/>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/>
   <Button Content="Move document" IsDefault="True" Click="Apply" Padding="14,6" AutomationProperties.AutomationId="ApplyDocumentMove"/>
  </StackPanel>
 </Grid>
</Window>
