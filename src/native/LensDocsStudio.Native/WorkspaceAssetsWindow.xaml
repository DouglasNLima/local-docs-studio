<Window x:Class="LensDocsStudio.Native.WorkspaceAssetsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Workspace images" Width="1000" Height="700" MinWidth="690" MinHeight="480" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Workspace images" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <TextBlock Grid.Row="1" Text="Local raster images and references in Markdown, Mermaid and text documents, including open saved-file drafts. Other file types, native recovery data and excluded folders are outside this audit." TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBox x:Name="Filter" Grid.Row="2" TextChanged="FilterChanged" Padding="7" Margin="0,0,0,12" AutomationProperties.Name="Filter images by path" AutomationProperties.AutomationId="AssetFilter"/>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="AssetList" DisplayMemberPath="Summary" SelectionChanged="AssetSelected" AutomationProperties.Name="Workspace image files" AutomationProperties.AutomationId="AssetList">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/></Style></ListBox.ItemContainerStyle>
   </ListBox>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12"><Image x:Name="AssetPreview" Stretch="Uniform" AutomationProperties.Name="Selected image preview"/></Border>
    <TextBlock x:Name="AssetDetails" Grid.Row="1" TextWrapping="Wrap" Margin="0,10,0,10" AutomationProperties.AutomationId="AssetDetails"/>
    <ListBox x:Name="UsageList" Grid.Row="2" AutomationProperties.Name="Documents using this image" AutomationProperties.AutomationId="AssetUsage"/>
   </Grid>
  </Grid>
  <ScrollViewer Grid.Row="4" MaxHeight="115" VerticalScrollBarVisibility="Auto" Margin="0,10,0,12"><TextBlock x:Name="AuditStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="AssetAuditStatus"/></ScrollViewer>
  <WrapPanel Grid.Row="5" HorizontalAlignment="Right">
   <Button x:Name="RenameButton" Content="Rename or move…" Click="Rename" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="RenameAsset"/>
   <Button x:Name="RemoveButton" Content="Remove unreferenced image…" Click="Remove" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="RemoveUnusedAsset"/>
   <Button Content="Refresh" Click="Refresh" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="RefreshAssets"/>
   <Button Content="Close" IsCancel="True" Padding="14,6" AutomationProperties.AutomationId="CloseAssets"/>
  </WrapPanel>
 </Grid>
</Window>
