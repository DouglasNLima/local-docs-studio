<Window x:Class="LensDocsStudio.Native.MermaidVisualEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit"
 Title="Mermaid visual editor" Width="1280" Height="840" MinWidth="880" MinHeight="600" WindowStartupLocation="CenterOwner"
 Icon="Resources/Brand/application.ico" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 AutomationProperties.AutomationId="MermaidVisualEditor" PreviewKeyDown="Shortcut">
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="Resources/CommandIcons.xaml"/><ResourceDictionary Source="Resources/DesktopStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries>
   <Style TargetType="Label"><Setter Property="Padding" Value="0,8,0,4"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
   <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
   <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="MaxLength" Value="4096"/></Style>
   <Style TargetType="Button"><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,5,4"/></Style>
   <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="30"/></Style>
   <Style x:Key="CanvasElement" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="2">
      <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="3"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <DockPanel Margin="12">
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" AutomationProperties.Name="Visual editor commands">
   <Button x:Name="UndoButton" Content="Undo" Click="Undo" ToolTip="Undo visual edit (Ctrl+Z)" AutomationProperties.AutomationId="MermaidUndo"/>
   <Button x:Name="RedoButton" Content="Redo" Click="Redo" ToolTip="Redo visual edit (Ctrl+Y)" AutomationProperties.AutomationId="MermaidRedo"/>
   <Button x:Name="DeleteButton" Content="Delete" Click="Delete" AutomationProperties.AutomationId="MermaidDelete"/>
   <Button x:Name="DuplicateButton" Content="Duplicate" Click="Duplicate" ToolTip="Duplicate selected nodes (Ctrl+D)" AutomationProperties.AutomationId="MermaidDuplicate"/>
   <Button Content="Auto Layout" Click="AutoLayout" AutomationProperties.AutomationId="MermaidAutoLayout"/>
   <Button Content="Fit" Click="Fit" ToolTip="Fit to Window (F)" AutomationProperties.AutomationId="MermaidFit"/>
   <Button Content="100%" Click="ActualSize" AutomationProperties.AutomationId="MermaidActualSize"/>
   <Button Content="Reset" Click="ResetView" AutomationProperties.AutomationId="MermaidReset"/>
   <Slider x:Name="Zoom" Minimum="1" Maximum="400" Value="100" Width="100" VerticalAlignment="Center" ValueChanged="ZoomChanged" AutomationProperties.Name="Canvas zoom percentage" AutomationProperties.AutomationId="MermaidZoom"/>
   <TextBlock x:Name="ZoomLabel" Text="100%" Width="50" Margin="6,5"/>
   <TextBlock Text="Direction" Margin="6,5"/>
   <ComboBox x:Name="Direction" Width="65" SelectionChanged="DirectionChanged" AutomationProperties.Name="Diagram direction" AutomationProperties.AutomationId="MermaidDirection"/>
   <Button Content="Rendered preview" Click="ShowRenderedPreview" AutomationProperties.AutomationId="MermaidRenderedPreview"/>
  </WrapPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,6" AutomationProperties.AutomationId="MermaidStatus" AutomationProperties.LiveSetting="Polite"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Drag positions last for this session. Mermaid controls layout after Apply or reopening." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button Content="Copy source" Click="CopySource" AutomationProperties.AutomationId="MermaidCopySource"/>
     <Button x:Name="EditSourceButton" Content="Edit source" Click="EditOwningSource" AutomationProperties.AutomationId="MermaidEditSource"/>
     <Button Content="Cancel" Click="Cancel" AutomationProperties.AutomationId="MermaidCancel"/>
     <Button x:Name="ApplyButton" Content="Apply" Click="Apply" ToolTip="Apply as one document Undo action (Ctrl+Enter)" AutomationProperties.AutomationId="MermaidApply"/>
    </StackPanel>
   </Grid>
  </StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="180" MinWidth="140"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="250"/><ColumnDefinition Width="5"/><ColumnDefinition Width="250" MinWidth="210"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0" Margin="0,0,8,0">
    <TextBlock DockPanel.Dock="Top" Text="Elements" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
    <WrapPanel x:Name="Palette" DockPanel.Dock="Top" PreviewMouseMove="PaletteDrag" AutomationProperties.Name="Insert diagram element">
     <Button Content="Process" Tag="Process" Click="InsertNode" AutomationProperties.AutomationId="MermaidInsertProcess"/>
     <Button Content="Decision" Tag="Decision" Click="InsertNode" AutomationProperties.AutomationId="MermaidInsertDecision"/>
     <Button Content="Start/End" Tag="Terminal" Click="InsertNode" AutomationProperties.AutomationId="MermaidInsertTerminal"/>
     <Button Content="Rounded" Tag="Rounded" Click="InsertNode" AutomationProperties.AutomationId="MermaidInsertRounded"/>
     <Button Content="Circle" Tag="Circle" Click="InsertNode" AutomationProperties.AutomationId="MermaidInsertCircle"/>
     <Button Content="Connection" Tag="Connection" Click="StartConnection" AutomationProperties.AutomationId="MermaidInsertConnection"/>
     <Button Content="Subgraph" Tag="Subgraph" Click="InsertSubgraph" AutomationProperties.AutomationId="MermaidInsertSubgraph"/>
    </WrapPanel>
    <TextBlock DockPanel.Dock="Top" Text="Select an element below or on the canvas. Ctrl selects several nodes." TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{DynamicResource MutedTextBrush}"/>
    <ListBox x:Name="Elements" SelectionMode="Extended" SelectionChanged="SelectionChanged" DisplayMemberPath="Description"
     AutomationProperties.Name="Diagram nodes, connections and subgraphs" AutomationProperties.AutomationId="MermaidElements"/>
   </DockPanel>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource BorderBrush}"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="5"/><RowDefinition Height="190" MinHeight="32"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="Viewport" Background="{DynamicResource WindowBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
     PreviewMouseWheel="CanvasWheel" PreviewMouseDown="PanStarted" PreviewMouseMove="PanMoved" PreviewMouseUp="PanFinished" LostMouseCapture="PanCaptureLost"
     AutomationProperties.Name="Interactive Mermaid canvas. Use the element list for keyboard selection; middle-drag pans." AutomationProperties.AutomationId="MermaidViewport">
     <Canvas x:Name="DiagramCanvas" Width="800" Height="600" Background="Transparent" AllowDrop="True" Drop="CanvasDrop" MouseLeftButtonDown="DeselectCanvas">
      <Canvas.LayoutTransform><ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform>
      <Canvas.ContextMenu><ContextMenu>
       <MenuItem Header="Add process" Tag="Process" Click="InsertNode"/><MenuItem Header="Add decision" Tag="Decision" Click="InsertNode"/>
       <MenuItem Header="Add subgraph" Click="InsertSubgraph"/><MenuItem Header="Connect selected node" Click="StartConnection"/>
       <MenuItem Header="Delete selection" Click="Delete"/><Separator/><MenuItem Header="Fit to Window" Click="Fit"/>
      </ContextMenu></Canvas.ContextMenu>
     </Canvas>
    </ScrollViewer>
    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource BorderBrush}"/>
    <Expander x:Name="SourcePanel" Grid.Row="2" Header="Mermaid source" IsExpanded="True" Expanded="SourceExpanded" Collapsed="SourceCollapsed" Margin="0,8,0,0">
     <DockPanel MinHeight="90">
      <Button x:Name="ValidateSourceButton" DockPanel.Dock="Bottom" Content="Validate source changes" Click="ValidateSource" HorizontalAlignment="Left" AutomationProperties.AutomationId="MermaidValidateSource"/>
      <edit:TextEditor x:Name="SourceEditor" ShowLineNumbers="True" FontFamily="Consolas" FontSize="13" WordWrap="False" TextChanged="SourceChanged"
       Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Mermaid draft source" AutomationProperties.AutomationId="MermaidDraftSource"/>
     </DockPanel>
    </Expander>
   </Grid>
   <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource BorderBrush}"/>
   <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,0,0">
    <StackPanel>
     <TextBlock Text="Properties" FontWeight="SemiBold" FontSize="16"/>
     <TextBlock x:Name="SelectionSummary" Text="Select a node, connection or subgraph." TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="MermaidSelectionSummary"/>
     <Button x:Name="ResetPropertiesButton" Content="Reset property changes" Click="ResetProperties" Margin="0,8,0,4" AutomationProperties.AutomationId="MermaidResetProperties"/>
     <StackPanel x:Name="NodeProperties" Visibility="Collapsed">
      <Label Content="Node _ID" Target="{Binding ElementName=NodeId}"/><TextBox x:Name="NodeId" MaxLength="128" AutomationProperties.AutomationId="MermaidNodeId"/>
      <Label Content="Node _label" Target="{Binding ElementName=NodeLabel}"/><TextBox x:Name="NodeLabel" AcceptsReturn="True" MinHeight="66" TextWrapping="Wrap" AutomationProperties.AutomationId="MermaidNodeLabel"/>
      <Label Content="_Shape" Target="{Binding ElementName=NodeShape}"/><ComboBox x:Name="NodeShape" AutomationProperties.Name="Node shape" AutomationProperties.AutomationId="MermaidNodeShape"/>
      <Button Content="Update node" Click="UpdateNode" Margin="0,8,0,4" AutomationProperties.AutomationId="MermaidUpdateNode"/>
      <Label Content="Subgraph membership"/><ComboBox x:Name="NodeGroup" AutomationProperties.Name="Node subgraph" AutomationProperties.AutomationId="MermaidNodeGroup"/>
      <Button Content="Move node" Click="MoveNode" Margin="0,8,0,4" AutomationProperties.AutomationId="MermaidMoveNode"/>
      <Label Content="Class defined in source"/><ComboBox x:Name="NodeClass" AutomationProperties.Name="Node class" AutomationProperties.AutomationId="MermaidNodeClass"/>
      <Button x:Name="ClassButton" Content="Apply class" Click="ApplyClass" Margin="0,8,0,4" AutomationProperties.AutomationId="MermaidApplyClass"/>
      <Label Content="Fill / stroke / text colour"/><TextBox x:Name="FillColour" Text="#FAFAFA" AutomationProperties.Name="Fill colour" AutomationProperties.AutomationId="MermaidFillColour"/>
      <TextBox x:Name="StrokeColour" Text="#56606C" Margin="0,4" AutomationProperties.Name="Stroke colour"/>
      <TextBox x:Name="TextColour" Text="#202124" AutomationProperties.Name="Text colour"/>
      <Button Content="Apply colours" Click="ApplyStyle" Margin="0,8,0,4" AutomationProperties.AutomationId="MermaidApplyStyle"/>
     </StackPanel>
     <StackPanel x:Name="EdgeProperties" Visibility="Collapsed">
      <Label Content="Source node"/><ComboBox x:Name="EdgeSource" AutomationProperties.Name="Connection source node" AutomationProperties.AutomationId="MermaidEdgeSource"/>
      <Label Content="Destination node"/><ComboBox x:Name="EdgeTarget" AutomationProperties.Name="Connection destination node" AutomationProperties.AutomationId="MermaidEdgeTarget"/>
      <Label Content="Connection label" Target="{Binding ElementName=EdgeLabel}"/><TextBox x:Name="EdgeLabel" AutomationProperties.AutomationId="MermaidEdgeLabel"/>
      <Label Content="Connection type"/><ComboBox x:Name="EdgeType" AutomationProperties.Name="Connection type" AutomationProperties.AutomationId="MermaidEdgeType"/>
      <Button Content="Update connection" Click="UpdateEdge" Margin="0,8,0,4" AutomationProperties.AutomationId="MermaidUpdateEdge"/>
      <Button Content="Reverse direction" Click="ReverseEdge" AutomationProperties.AutomationId="MermaidReverseEdge"/>
     </StackPanel>
     <StackPanel x:Name="GroupProperties" Visibility="Collapsed">
      <Label Content="Subgraph ID"/><TextBlock x:Name="GroupId"/>
      <Label Content="Subgraph label" Target="{Binding ElementName=GroupLabel}"/><TextBox x:Name="GroupLabel" AutomationProperties.AutomationId="MermaidGroupLabel"/>
      <TextBlock x:Name="GroupMembers" TextWrapping="Wrap" Margin="0,8"/>
      <Label Content="Subgraph direction"/><ComboBox x:Name="GroupDirection" AutomationProperties.Name="Subgraph direction" AutomationProperties.AutomationId="MermaidGroupDirection"/>
      <Button Content="Update subgraph" Click="UpdateGroup" Margin="0,8,0,4" AutomationProperties.AutomationId="MermaidUpdateGroup"/>
      <CheckBox x:Name="DeleteGroupContents" Content="Also delete members and their connections" Margin="0,8" AutomationProperties.AutomationId="MermaidDeleteGroupContents"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
