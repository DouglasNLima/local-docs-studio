<Window x:Class="LensDocsStudio.Native.MermaidVisualEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:ui="clr-namespace:LensDocsStudio.Native.Controls"
 Title="Mermaid Visual Editor" Width="1280" Height="840" MinWidth="880" MinHeight="600" WindowStartupLocation="CenterOwner"
 FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
 Icon="Resources/Brand/application.ico" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 AutomationProperties.AutomationId="MermaidVisualEditor" PreviewKeyDown="Shortcut">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Resources/MermaidEditorStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="DraftIndicator" Text="Ready" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.AutomationId="MermaidDraftState"/></StackPanel>
    <StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="Mermaid" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="Mermaid Visual Editor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text=" / Flowchart" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="4,0"/></StackPanel>
   </DockPanel>
  </Border>
  <ToolBar DockPanel.Dock="Top" Style="{StaticResource Desktop.DiagramToolbar}" AutomationProperties.Name="Visual editor commands" AutomationProperties.AutomationId="MermaidToolbar">
<Button x:Name="ArrangeButton" Content="Arrange…" IsEnabled="False" Click="OpenArrangement" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="MermaidArrange" ToolTip="Open Navigate and Arrange modes with separate layout history and workspace persistence"/>
<Button x:Name="UndoButton" Style="{StaticResource Mermaid.ToolbarButton}" Click="Undo" ToolTip="Undo visual edit (Ctrl+Z)" AutomationProperties.AutomationId="MermaidUndo"><StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="Undo"/></StackPanel></Button>
<Button x:Name="RedoButton" Style="{StaticResource Mermaid.ToolbarButton}" Click="Redo" ToolTip="Redo visual edit (Ctrl+Y)" AutomationProperties.AutomationId="MermaidRedo"><StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="Redo"/></StackPanel></Button>
<Separator/>
<Button x:Name="DeleteButton" Style="{StaticResource Mermaid.ToolbarButton}" Click="Delete" ToolTip="Delete selection (Delete)" AutomationProperties.AutomationId="MermaidDelete"><StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="Delete"/></StackPanel></Button>
<Button x:Name="DuplicateButton" Style="{StaticResource Mermaid.ToolbarButton}" Click="Duplicate" ToolTip="Duplicate selected nodes (Ctrl+D)" AutomationProperties.AutomationId="MermaidDuplicate"><StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="Duplicate"/></StackPanel></Button>
<Button  Style="{StaticResource Mermaid.ToolbarButton}" Click="AutoLayout" ToolTip="Restore automatic layout; session positions are cleared" AutomationProperties.AutomationId="MermaidAutoLayout"><StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="AutoLayout"/><TextBlock Text="Auto layout" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
<Separator/><StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center"><Label Content="_Direction" Target="{Binding ElementName=Direction}" Style="{StaticResource Form.Label}" Padding="0,0,6,0" VerticalAlignment="Center"/><ComboBox x:Name="Direction" Width="70" Style="{StaticResource Form.ComboBox}" SelectionChanged="DirectionChanged" ToolTip="Direction used by Mermaid automatic layout" AutomationProperties.Name="Diagram direction" AutomationProperties.AutomationId="MermaidDirection"/></StackPanel><Separator/>
<Button  Style="{StaticResource Mermaid.ToolbarButton}" Click="ZoomOut" ToolTip="Zoom out (Ctrl+mouse wheel)" AutomationProperties.AutomationId="MermaidZoomOut"><StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="ZoomOut"/></StackPanel></Button>
<Slider x:Name="Zoom" Minimum="1" Maximum="400" Value="100" Width="80" VerticalAlignment="Center" ValueChanged="ZoomChanged" ToolTip="Canvas zoom; Ctrl+mouse wheel zooms around the pointer" AutomationProperties.Name="Canvas zoom percentage" AutomationProperties.AutomationId="MermaidZoom"/>
<Button  Style="{StaticResource Mermaid.ToolbarButton}" Click="ZoomIn" ToolTip="Zoom in (Ctrl+mouse wheel)" AutomationProperties.AutomationId="MermaidZoomIn"><StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="ZoomIn"/></StackPanel></Button>
<TextBlock x:Name="ZoomLabel" Text="{Binding Value, ElementName=Zoom, StringFormat={}{0:0.#}%}" MinWidth="42" VerticalAlignment="Center" TextAlignment="Center"/>
<Button  Style="{StaticResource Mermaid.ToolbarButton}" Click="Fit" ToolTip="Fit diagram to window (F)" AutomationProperties.AutomationId="MermaidFit"><StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="Focus"/></StackPanel></Button>
<Button  Style="{StaticResource Mermaid.ToolbarButton}" Click="ActualSize" ToolTip="Actual size (Ctrl+0)" AutomationProperties.AutomationId="MermaidActualSize"><StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="Selection"/></StackPanel></Button>
<Button  Style="{StaticResource Mermaid.ToolbarButton}" Click="ResetView" ToolTip="Reset view (Home)" AutomationProperties.AutomationId="MermaidReset"><StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="Refresh"/></StackPanel></Button>
<Separator/>
<Button Style="{StaticResource Mermaid.ToolbarButton}" Click="ToggleSource" ToolTip="Show or hide Mermaid source" AutomationProperties.AutomationId="MermaidToggleSource"><ui:CommandIcon Kind="Code"/></Button>
<Button x:Name="RenderedPreviewButton" Style="{StaticResource Mermaid.ToolbarButton}" Click="ShowRenderedPreview" ToolTip="Rendered preview" AutomationProperties.AutomationId="MermaidRenderedPreview"><ui:CommandIcon Kind="Preview"/></Button></ToolBar>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <DockPanel Margin="0,0,12,0" VerticalAlignment="Center"><ui:CommandIcon Kind="Info" DockPanel.Dock="Left" Margin="0,0,8,0" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="Status" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" AutomationProperties.AutomationId="MermaidStatus" AutomationProperties.LiveSetting="Polite"/></DockPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="EditSourceButton" Content="Edit source" Style="{StaticResource Form.Action}" Margin="0,0,12,0" Click="EditOwningSource" ToolTip="Open the owning document source; this draft stays open" AutomationProperties.AutomationId="MermaidEditSource"/>
     <Button Content="Cancel" Style="{StaticResource Form.Action}" Margin="0" MinWidth="72" Click="Cancel" AutomationProperties.AutomationId="MermaidCancel"/>
     <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource Mermaid.PrimaryAction}" Click="Apply" ToolTip="Apply changes as one document Undo action (Ctrl+Enter)" AutomationProperties.AutomationId="MermaidApply"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Margin="8,8,8,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="180"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="7"/><ColumnDefinition Width="280" MinWidth="224"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0" Background="{DynamicResource PanelBrush}" Margin="0,0,3,8">
    <TextBlock DockPanel.Dock="Top" Text="ELEMENTS" Style="{StaticResource Desktop.PanelHeading}"/>
    <UniformGrid x:Name="Palette" DockPanel.Dock="Top" Columns="2" Margin="6,2" PreviewMouseMove="PaletteDrag" AutomationProperties.Name="Insert diagram element">
<Button Tag="Process" Style="{StaticResource Mermaid.PaletteItem}" Click="InsertNode" ToolTip="Add process; drag to place on the canvas" AutomationProperties.Name="Process" AutomationProperties.AutomationId="MermaidInsertProcess"><StackPanel><ui:CommandIcon Kind="Process" Width="24" Height="24" HorizontalAlignment="Center"/><TextBlock Text="Process" TextAlignment="Center" Margin="0,5,0,0" FontSize="11"/></StackPanel></Button>
<Button Tag="Decision" Style="{StaticResource Mermaid.PaletteItem}" Click="InsertNode" ToolTip="Add decision; drag to place on the canvas" AutomationProperties.Name="Decision" AutomationProperties.AutomationId="MermaidInsertDecision"><StackPanel><ui:CommandIcon Kind="Decision" Width="24" Height="24" HorizontalAlignment="Center"/><TextBlock Text="Decision" TextAlignment="Center" Margin="0,5,0,0" FontSize="11"/></StackPanel></Button>
<Button Tag="Terminal" Style="{StaticResource Mermaid.PaletteItem}" Click="InsertNode" ToolTip="Add start/end; drag to place on the canvas" AutomationProperties.Name="Start/End" AutomationProperties.AutomationId="MermaidInsertTerminal"><StackPanel><ui:CommandIcon Kind="Terminal" Width="24" Height="24" HorizontalAlignment="Center"/><TextBlock Text="Start/End" TextAlignment="Center" Margin="0,5,0,0" FontSize="11"/></StackPanel></Button>
<Button Tag="Rounded" Style="{StaticResource Mermaid.PaletteItem}" Click="InsertNode" ToolTip="Add rounded; drag to place on the canvas" AutomationProperties.Name="Rounded" AutomationProperties.AutomationId="MermaidInsertRounded"><StackPanel><ui:CommandIcon Kind="Rounded" Width="24" Height="24" HorizontalAlignment="Center"/><TextBlock Text="Rounded" TextAlignment="Center" Margin="0,5,0,0" FontSize="11"/></StackPanel></Button>
<Button Tag="Circle" Style="{StaticResource Mermaid.PaletteItem}" Click="InsertNode" ToolTip="Add circle; drag to place on the canvas" AutomationProperties.Name="Circle" AutomationProperties.AutomationId="MermaidInsertCircle"><StackPanel><ui:CommandIcon Kind="Circle" Width="24" Height="24" HorizontalAlignment="Center"/><TextBlock Text="Circle" TextAlignment="Center" Margin="0,5,0,0" FontSize="11"/></StackPanel></Button>
<Button x:Name="StartConnectionButton" Tag="Connection" Style="{StaticResource Mermaid.PaletteItem}" Click="StartConnection" ToolTip="Connect selected nodes" AutomationProperties.Name="Connection" AutomationProperties.AutomationId="MermaidInsertConnection"><StackPanel><ui:CommandIcon Kind="Connection" Width="24" Height="24" HorizontalAlignment="Center"/><TextBlock Text="Connection" TextAlignment="Center" Margin="0,5,0,0" FontSize="11"/></StackPanel></Button>
<Button x:Name="InsertSubgraphButton" Tag="Subgraph" Style="{StaticResource Mermaid.PaletteItem}" Click="InsertSubgraph" ToolTip="Add subgraph; drag to place on the canvas" AutomationProperties.Name="Subgraph" AutomationProperties.AutomationId="MermaidInsertSubgraph"><StackPanel><ui:CommandIcon Kind="Subgraph" Width="24" Height="24" HorizontalAlignment="Center"/><TextBlock Text="Subgraph" TextAlignment="Center" Margin="0,5,0,0" FontSize="11"/></StackPanel></Button>
</UniformGrid>
    <TextBlock DockPanel.Dock="Top" Text="DIAGRAM" Style="{StaticResource Desktop.PanelHeading}"/>
    <TextBlock DockPanel.Dock="Bottom" Text="Ctrl+click selects several nodes" Style="{StaticResource Form.Help}" Margin="10,8"/>
    <ListBox Style="{StaticResource Mermaid.Navigation}" VirtualizingPanel.VirtualizationMode="Standard" x:Name="Elements" SelectionMode="Extended" SelectionChanged="SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource Mermaid.NavigationItem}" AutomationProperties.Name="Diagram nodes, connections and subgraphs" AutomationProperties.AutomationId="MermaidElements">
     <ListBox.GroupStyle><StaticResource ResourceKey="Mermaid.NavigationGroup"/></ListBox.GroupStyle>
     <ListBox.ItemTemplate><DataTemplate><DockPanel ToolTip="{Binding Description}"><ui:CommandIcon Kind="{Binding Icon}" DockPanel.Dock="Left" Margin="0,0,7,0" Width="16" Height="16" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <GridSplitter Style="{StaticResource Mermaid.Splitter}" AutomationProperties.Name="Resize navigation panel" AutomationProperties.AutomationId="MermaidNavigationSplitter" Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
   <Grid Grid.Column="2" Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="7"/><RowDefinition Height="190" MinHeight="40"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
    <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel Margin="10,0"><TextBlock Text="CANVAS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock Text="Mermaider layout" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" ToolTip="The original preview layout is preserved. Space+drag pans. Mermaid does not store manual node coordinates."/></DockPanel></Border>
     <ScrollViewer x:Name="Viewport" AllowDrop="True" Drop="CanvasDrop" Grid.Row="1" Background="{DynamicResource WindowBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
      PreviewMouseWheel="CanvasWheel" PreviewMouseDown="PanStarted" PreviewMouseMove="PanMoved" PreviewMouseUp="PanFinished" LostMouseCapture="PanCaptureLost"
      AutomationProperties.Name="Interactive Mermaid canvas. Use the element list for keyboard selection; middle-drag pans." AutomationProperties.AutomationId="MermaidViewport">
      <Canvas x:Name="DiagramCanvas" Width="800" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" AllowDrop="True" MouseLeftButtonDown="DeselectCanvas">
       <Canvas.LayoutTransform><ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform>
       <Canvas.ContextMenu><ContextMenu><MenuItem Header="Add process" Tag="Process" Click="InsertNode"/><MenuItem Header="Add decision" Tag="Decision" Click="InsertNode"/><MenuItem Header="Add subgraph" Click="InsertSubgraph"/><MenuItem Header="Connect selected node" Click="StartConnection"/><MenuItem Header="Delete selection" Click="Delete"/><Separator/><MenuItem Header="Fit to window" Click="Fit"/></ContextMenu></Canvas.ContextMenu>
      </Canvas>
     </ScrollViewer>
    </Grid></Border>
    <GridSplitter Style="{StaticResource Mermaid.Splitter}" x:Name="SourceSplitter" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
    <Expander x:Name="SourcePanel" Grid.Row="2" Style="{StaticResource Mermaid.SourcePanel}" IsExpanded="True" Expanded="SourceExpanded" Collapsed="SourceCollapsed" AutomationProperties.AutomationId="MermaidSourcePanel">
     <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Mermaid source"/><TextBlock x:Name="SourceStateIndicator" Text=" *" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" AutomationProperties.AutomationId="MermaidSourceState"/></StackPanel></Expander.Header>
     <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1" Padding="4,8,4,4">
      <edit:TextEditor x:Name="SourceEditor" ShowLineNumbers="True" FontFamily="Cascadia Code, Consolas" FontSize="14" WordWrap="False" TextChanged="SourceChanged" Padding="2,2" LineNumbersForeground="{DynamicResource MutedTextBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Mermaid draft source" AutomationProperties.AutomationId="MermaidDraftSource"/>
     </Border>
    </Expander>
    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,3,5,0">
     <Button x:Name="ValidateSourceButton" Style="{StaticResource Mermaid.ToolbarButton}" Click="ValidateSource" ToolTip="Validate source changes before continuing visually" AutomationProperties.AutomationId="MermaidValidateSource"><ui:CommandIcon Kind="Check"/></Button>
     <Button Style="{StaticResource Mermaid.ToolbarButton}" Click="ShowOriginal" ToolTip="Inspect original Mermaid source" AutomationProperties.AutomationId="MermaidOriginal"><ui:CommandIcon Kind="Info"/></Button>
     <Button Style="{StaticResource Mermaid.ToolbarButton}" Click="CopySource" ToolTip="Copy Mermaid draft source" AutomationProperties.AutomationId="MermaidCopySource"><ui:CommandIcon Kind="Copy"/></Button>
    </StackPanel>
   </Grid>
   <GridSplitter Style="{StaticResource Mermaid.Splitter}" AutomationProperties.Name="Resize inspector panel" AutomationProperties.AutomationId="MermaidInspectorSplitter" Grid.Column="3" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
   <ui:MermaidInspectorPanel Grid.Column="4" Background="{DynamicResource PanelBrush}" Margin="3,0,0,8" AutomationProperties.Name="Selected element properties" AutomationProperties.AutomationId="MermaidInspectorPanel">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="12,12,12,8"><TextBlock Text="PROPERTIES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
     <TextBlock x:Name="CapabilitySummary" FontWeight="SemiBold" Margin="0,6,0,0" AutomationProperties.AutomationId="MermaidCapabilities"/><TextBlock x:Name="SelectionSummary" Style="{StaticResource Mermaid.InspectorHeading}" Text="Select a node, connection or subgraph to edit its properties." TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" AutomationProperties.AutomationId="MermaidSelectionSummary"/>
     <TextBlock x:Name="CapabilityDetails" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" AutomationProperties.AutomationId="MermaidOperationPermissions"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12">
     <StackPanel>
      <TextBlock x:Name="InspectionProperties" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="MermaidInspectionProperties"/>
      <StackPanel x:Name="InspectorEmpty" Margin="4,24"><ui:CommandIcon Kind="Selection" Width="32" Height="32" HorizontalAlignment="Left" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="Select an element on the canvas or in the diagram list. Its editable properties will appear here." Style="{StaticResource Form.Help}"/></StackPanel>
<StackPanel x:Name="NodeProperties" Visibility="Collapsed"><TextBlock Text="IDENTITY" Style="{StaticResource Mermaid.Section}"/><StackPanel Style="{StaticResource Form.Field}"><Label Content="Node _ID" Target="{Binding ElementName=NodeId}" Style="{StaticResource Form.Label}"/><TextBox x:Name="NodeId" Style="{StaticResource Mermaid.PropertyInput}" AutomationProperties.Name="Node ID" AutomationProperties.AutomationId="MermaidNodeId" MaxLength="128"/></StackPanel><StackPanel Style="{StaticResource Form.Field}"><Label Content="Node _label" Target="{Binding ElementName=NodeLabel}" Style="{StaticResource Form.Label}"/><TextBox x:Name="NodeLabel" Style="{StaticResource Mermaid.PropertyInput}" AutomationProperties.Name="Node label" AutomationProperties.AutomationId="MermaidNodeLabel" AcceptsReturn="True" MinHeight="64" MaxHeight="150" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel><TextBlock Text="APPEARANCE" Style="{StaticResource Mermaid.Section}"/><StackPanel Style="{StaticResource Form.Field}"><Label Content="_Shape" Target="{Binding ElementName=NodeShape}" Style="{StaticResource Form.Label}"/><ComboBox x:Name="NodeShape" Style="{StaticResource Form.ComboBox}" AutomationProperties.Name="Shape" AutomationProperties.AutomationId="MermaidNodeShape" /></StackPanel><StackPanel x:Name="NodeClassField" Style="{StaticResource Form.Field}"><Label Content="Class defined in source" Target="{Binding ElementName=NodeClass}" Style="{StaticResource Form.Label}"/><ComboBox x:Name="NodeClass" Style="{StaticResource Form.ComboBox}" AutomationProperties.Name="Class defined in source" AutomationProperties.AutomationId="MermaidNodeClass" /></StackPanel><Button x:Name="ClassButton" Content="Apply class" Style="{StaticResource Mermaid.Action}" Click="ApplyClass" AutomationProperties.AutomationId="MermaidApplyClass"/><TextBlock Text="COLOURS" Style="{StaticResource Mermaid.Section}"/><StackPanel Style="{StaticResource Form.Field}"><Label Content="Fill" Target="{Binding ElementName=FillColour}" Style="{StaticResource Form.Label}"/><DockPanel><Border x:Name="FillSwatch" DockPanel.Dock="Left" Style="{StaticResource Mermaid.Swatch}"/><TextBox x:Name="FillColour" Style="{StaticResource Mermaid.PropertyInput}" Text="#FAFAFA" AutomationProperties.Name="Fill colour" AutomationProperties.AutomationId="MermaidFillColour"/></DockPanel></StackPanel><StackPanel Style="{StaticResource Form.Field}"><Label Content="Stroke" Target="{Binding ElementName=StrokeColour}" Style="{StaticResource Form.Label}"/><DockPanel><Border x:Name="StrokeSwatch" DockPanel.Dock="Left" Style="{StaticResource Mermaid.Swatch}"/><TextBox x:Name="StrokeColour" Style="{StaticResource Mermaid.PropertyInput}" Text="#FAFAFA" AutomationProperties.Name="Stroke colour" AutomationProperties.AutomationId="MermaidStrokeColour"/></DockPanel></StackPanel><StackPanel Style="{StaticResource Form.Field}"><Label Content="Text" Target="{Binding ElementName=TextColour}" Style="{StaticResource Form.Label}"/><DockPanel><Border x:Name="TextSwatch" DockPanel.Dock="Left" Style="{StaticResource Mermaid.Swatch}"/><TextBox x:Name="TextColour" Style="{StaticResource Mermaid.PropertyInput}" Text="#FAFAFA" AutomationProperties.Name="Text colour" AutomationProperties.AutomationId="MermaidTextColour"/></DockPanel></StackPanel><TextBlock Text="Use six-digit hexadecimal colours, for example #FF883E." Style="{StaticResource Form.Help}"/><Button x:Name="ApplyStyleButton"  Content="Apply colours" Style="{StaticResource Mermaid.Action}" Click="ApplyStyle" AutomationProperties.AutomationId="MermaidApplyStyle"/><TextBlock Text="STRUCTURE" Style="{StaticResource Mermaid.Section}"/><StackPanel Style="{StaticResource Form.Field}"><Label Content="Subgraph membership" Target="{Binding ElementName=NodeGroup}" Style="{StaticResource Form.Label}"/><ComboBox x:Name="NodeGroup" Style="{StaticResource Form.ComboBox}" AutomationProperties.Name="Subgraph membership" AutomationProperties.AutomationId="MermaidNodeGroup" /></StackPanel><Button x:Name="MoveNodeButton"  Content="Move node" Style="{StaticResource Mermaid.Action}" Click="MoveNode" AutomationProperties.AutomationId="MermaidMoveNode"/></StackPanel><StackPanel x:Name="EdgeProperties" Visibility="Collapsed"><TextBlock Text="CONNECTION" Style="{StaticResource Mermaid.Section}"/><StackPanel Style="{StaticResource Form.Field}"><Label Content="Source node" Target="{Binding ElementName=EdgeSource}" Style="{StaticResource Form.Label}"/><ComboBox x:Name="EdgeSource" Style="{StaticResource Form.ComboBox}" AutomationProperties.Name="Source node" AutomationProperties.AutomationId="MermaidEdgeSource" /></StackPanel><StackPanel Style="{StaticResource Form.Field}"><Label Content="Destination node" Target="{Binding ElementName=EdgeTarget}" Style="{StaticResource Form.Label}"/><ComboBox x:Name="EdgeTarget" Style="{StaticResource Form.ComboBox}" AutomationProperties.Name="Destination node" AutomationProperties.AutomationId="MermaidEdgeTarget" /></StackPanel><StackPanel Style="{StaticResource Form.Field}"><Label Content="Connection label" Target="{Binding ElementName=EdgeLabel}" Style="{StaticResource Form.Label}"/><TextBox x:Name="EdgeLabel" Style="{StaticResource Mermaid.PropertyInput}" AutomationProperties.Name="Connection label" AutomationProperties.AutomationId="MermaidEdgeLabel" /></StackPanel><StackPanel Style="{StaticResource Form.Field}"><Label Content="Connection type" Target="{Binding ElementName=EdgeType}" Style="{StaticResource Form.Label}"/><ComboBox x:Name="EdgeType" Style="{StaticResource Form.ComboBox}" AutomationProperties.Name="Connection type" AutomationProperties.AutomationId="MermaidEdgeType" /></StackPanel><Button x:Name="ReverseEdgeButton"  Content="Reverse direction" Style="{StaticResource Mermaid.Action}" Click="ReverseEdge" AutomationProperties.AutomationId="MermaidReverseEdge"/></StackPanel><StackPanel x:Name="GroupProperties" Visibility="Collapsed"><TextBlock Text="IDENTITY" Style="{StaticResource Mermaid.Section}"/><TextBlock Text="Subgraph ID" Style="{StaticResource Form.Help}"/><TextBlock x:Name="GroupId" FontWeight="SemiBold" Margin="0,4,0,16"/><StackPanel Style="{StaticResource Form.Field}"><Label Content="Subgraph label" Target="{Binding ElementName=GroupLabel}" Style="{StaticResource Form.Label}"/><TextBox x:Name="GroupLabel" Style="{StaticResource Mermaid.PropertyInput}" AutomationProperties.Name="Subgraph label" AutomationProperties.AutomationId="MermaidGroupLabel" /></StackPanel><TextBlock Text="STRUCTURE" Style="{StaticResource Mermaid.Section}"/><StackPanel Style="{StaticResource Form.Field}"><Label Content="Subgraph direction" Target="{Binding ElementName=GroupDirection}" Style="{StaticResource Form.Label}"/><ComboBox x:Name="GroupDirection" Style="{StaticResource Form.ComboBox}" AutomationProperties.Name="Subgraph direction" AutomationProperties.AutomationId="MermaidGroupDirection" /></StackPanel><TextBlock x:Name="GroupMembers" TextWrapping="Wrap" Style="{StaticResource Form.Help}"/><CheckBox x:Name="DeleteGroupContents" Style="{StaticResource Form.CheckBox}" Margin="0,16,0,0" AutomationProperties.AutomationId="MermaidDeleteGroupContents"><TextBlock Text="Also delete members and their connections" TextWrapping="Wrap"/></CheckBox></StackPanel></StackPanel></ScrollViewer><WrapPanel Grid.Row="2" Margin="12,8"><Button x:Name="UpdateNodeButton" Content="Update node" Style="{StaticResource Mermaid.PrimaryAction}" Click="UpdateNode" Visibility="Collapsed" ToolTip="Update all pending properties for this node" AutomationProperties.AutomationId="MermaidUpdateNode"/>
     <Button x:Name="ResetPropertiesButton" Content="Reset changes" ToolTip="Reset unapplied property changes" Style="{StaticResource Mermaid.Action}" Click="ResetProperties" AutomationProperties.AutomationId="MermaidResetProperties"/><Button  Content="Update connection" Style="{StaticResource Mermaid.PrimaryAction}" Click="UpdateEdge" AutomationProperties.AutomationId="MermaidUpdateEdge" Visibility="{Binding Visibility, ElementName=EdgeProperties}" IsEnabled="{Binding IsEnabled, ElementName=EdgeProperties}"/><Button  Content="Update subgraph" Style="{StaticResource Mermaid.PrimaryAction}" Click="UpdateGroup" AutomationProperties.AutomationId="MermaidUpdateGroup" Visibility="{Binding Visibility, ElementName=GroupProperties}" IsEnabled="{Binding IsEnabled, ElementName=GroupProperties}"/></WrapPanel></Grid></ui:MermaidInspectorPanel>
  </Grid>
 </DockPanel>
</Window>
