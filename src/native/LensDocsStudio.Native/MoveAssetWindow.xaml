<Window x:Class="LensDocsStudio.Native.MoveAssetWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Review image move" Width="680" Height="500" MinWidth="460" MinHeight="350" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Review the image and link changes" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBlock x:Name="MoveSummary" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,14"/>
  <ListBox x:Name="AffectedDocuments" Grid.Row="2" AutomationProperties.Name="Documents with planned image reference changes" AutomationProperties.AutomationId="AssetMoveDocuments"/>
  <TextBlock Grid.Row="3" Text="Markdown references will be updated. Existing files are never replaced. An independent image copy is retained in Document snapshots." TextWrapping="Wrap" Margin="0,12,0,12"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/>
   <Button Content="Move image" IsDefault="True" Click="Apply" Padding="14,6" AutomationProperties.AutomationId="ApplyAssetMove"/>
  </StackPanel>
 </Grid>
</Window>
