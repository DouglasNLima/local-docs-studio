<Window x:Class="LensDocsStudio.Native.CommandSearchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Command Palette" Width="640" Height="460" MinWidth="440" MinHeight="300" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" Icon="Resources/Brand/application.ico"
 PreviewKeyDown="SearchKeyDown" AutomationProperties.AutomationId="CommandSearchWindow">
 <DockPanel Margin="16">
  <TextBlock x:Name="SearchTitle" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBox x:Name="Query" DockPanel.Dock="Top" Padding="8" Margin="0,0,0,10" TextChanged="QueryChanged"
   AutomationProperties.Name="Search" AutomationProperties.AutomationId="CommandSearchQuery"/>
  <TextBlock x:Name="ResultStatus" DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
   AutomationProperties.LiveSetting="Polite"/>
  <ListBox x:Name="Results" MouseDoubleClick="Confirm" AutomationProperties.Name="Search results" AutomationProperties.AutomationId="CommandSearchResults">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
    <Setter Property="ToolTip" Value="{Binding Detail}"/>
   </Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="6">
    <TextBlock Text="{Binding Detail}" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
   </DockPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </DockPanel>
</Window>
