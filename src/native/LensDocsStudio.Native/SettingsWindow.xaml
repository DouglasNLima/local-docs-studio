<Window x:Class="LensDocsStudio.Native.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Settings" Width="700" Height="750" MinWidth="560" MinHeight="520" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Padding" Value="8,5"/><Setter Property="MinWidth" Value="160"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,8,0,0"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" IsEnabled="{Binding CanEdit}">
   <StackPanel>
    <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Label Content="_Theme" Target="{Binding ElementName=Theme}"/>
      <ComboBox x:Name="Theme" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Theme" AutomationProperties.AutomationId="SettingsTheme"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <Label Content="_Layout" Target="{Binding ElementName=Layout}"/>
      <ComboBox x:Name="Layout" ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}" AutomationProperties.Name="Layout" AutomationProperties.AutomationId="SettingsLayout"/>
     </StackPanel>
    </Grid>
    <CheckBox Content="Show document _outline" IsChecked="{Binding ShowOutline}" AutomationProperties.AutomationId="SettingsOutline"/>
    <TextBlock Text="System follows Windows, including high-contrast settings." TextWrapping="Wrap" Margin="0,8,0,18"/>
    <Separator/>
    <TextBlock Text="Editor" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Label Content="_Font" Target="{Binding ElementName=EditorFont}"/>
      <ComboBox x:Name="EditorFont" ItemsSource="{Binding Fonts}" SelectedItem="{Binding FontFamily}" AutomationProperties.Name="Editor font" AutomationProperties.AutomationId="SettingsFont"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <Label Content="Font _size" Target="{Binding ElementName=EditorSize}"/>
      <ComboBox x:Name="EditorSize" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" AutomationProperties.Name="Editor font size" AutomationProperties.AutomationId="SettingsFontSize"/>
     </StackPanel>
    </Grid>
    <CheckBox Content="_Wrap long lines" IsChecked="{Binding WordWrap}" AutomationProperties.AutomationId="SettingsWordWrap"/>
    <CheckBox Content="Show line _numbers" IsChecked="{Binding ShowLineNumbers}" AutomationProperties.AutomationId="SettingsLineNumbers"/>
    <Label Content="_Indentation width" Target="{Binding ElementName=Indentation}" Margin="0,8,0,0"/>
    <ComboBox x:Name="Indentation" ItemsSource="{Binding IndentationSizes}" SelectedItem="{Binding IndentationSize}" HorizontalAlignment="Left" AutomationProperties.Name="Indentation width" AutomationProperties.AutomationId="SettingsIndentation"/>
    <CheckBox Content="Insert spaces when pressing _Tab" IsChecked="{Binding ConvertTabsToSpaces}" AutomationProperties.AutomationId="SettingsSpaces"/>
    <TextBlock Text="Indentation settings affect new typing. Existing tabs and spaces stay unchanged." TextWrapping="Wrap" Margin="0,8,0,18"/>
    <Separator/>
    <TextBlock Text="Preview" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8"/>
     <DockPanel Margin="0,0,0,8">
      <Label DockPanel.Dock="Left" Content="_Reading mode" Target="{Binding ElementName=ReadingMode}"/>
      <ComboBox x:Name="ReadingMode" ItemsSource="{Binding ReadingModes}" SelectedItem="{Binding PreviewReadingMode}"
       AutomationProperties.Name="Preview reading mode" AutomationProperties.AutomationId="SettingsReadingMode"/>
     </DockPanel>
     <TextBlock Text="Automatic uses pages for long documents. Continuous keeps one scrolling view." TextWrapping="Wrap" Margin="0,0,0,12"/>
    <DockPanel>
     <Label DockPanel.Dock="Left" Content="_Zoom" Target="{Binding ElementName=Zoom}"/>
     <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewZoom, StringFormat={}{0}%}" MinWidth="46" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.AutomationId="SettingsZoomValue"/>
     <Slider x:Name="Zoom" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding PreviewZoom}" VerticalAlignment="Center" AutomationProperties.Name="Preview zoom" AutomationProperties.AutomationId="SettingsZoom"/>
    </DockPanel>
    <TextBlock Text="Zoom changes the native preview only. Export sizes stay unchanged." TextWrapping="Wrap" Margin="0,8,0,16"/>
    <TextBlock Text="Update checks and release channels are available from Help → Updates." TextWrapping="Wrap" Margin="0,0,0,12"/>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,16,0,14" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SettingsStatus"/>
  <WrapPanel Grid.Row="3" Margin="0,0,0,12" IsEnabled="{Binding CanEdit}">
   <Button Content="Import settings…" Click="ImportSettings" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="SettingsImport"/>
   <Button Content="Export settings…" Click="ExportSettings" Padding="12,6" AutomationProperties.AutomationId="SettingsExport" ToolTip="Save the appearance choices currently selected in this dialogue"/>
  </WrapPanel>
  <DockPanel Grid.Row="4">
   <Button DockPanel.Dock="Left" Content="Restore defaults" Command="{Binding ResetCommand}" Padding="12,6" AutomationProperties.AutomationId="SettingsReset"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Cancel" IsCancel="True" IsEnabled="{Binding CanEdit}" Padding="16,6" Margin="0,0,8,0" AutomationProperties.AutomationId="SettingsCancel"/>
    <Button Content="Apply" IsDefault="True" Command="{Binding ApplyCommand}" Padding="16,6" AutomationProperties.AutomationId="SettingsApply"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>
