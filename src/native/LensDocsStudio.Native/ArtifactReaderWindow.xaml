<Window x:Class="LensDocsStudio.Native.ArtifactReaderWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Artefact bundle" Width="940" Height="780" MinWidth="700" MinHeight="560" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="ArtifactTitle"/>
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding Provenance}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,10,0,8" AutomationProperties.AutomationId="ArtifactEvidenceNotes"/>
   </StackPanel>
  </ScrollViewer>
  <ScrollViewer Grid.Row="1" MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
   <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" AutomationProperties.AutomationId="ArtifactWarnings"/>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0">
    <Label Content="_Find an item" Target="{Binding ElementName=Query}"/>
    <TextBox x:Name="Query" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" Padding="8,5" AutomationProperties.Name="Find an artefact" AutomationProperties.AutomationId="ArtifactQuery"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,12,0">
    <Label Content="_Group" Target="{Binding ElementName=Group}"/>
    <ComboBox x:Name="Group" ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" Padding="6,5" AutomationProperties.Name="Artefact group" AutomationProperties.AutomationId="ArtifactGroup"/>
   </StackPanel>
   <StackPanel Grid.Column="2">
    <Label Content="_Evidence label" Target="{Binding ElementName=Evidence}"/>
    <ComboBox x:Name="Evidence" ItemsSource="{Binding EvidenceLevels}" SelectedItem="{Binding Evidence}" Padding="6,5" AutomationProperties.Name="Supplied evidence label" AutomationProperties.AutomationId="ArtifactEvidence"/>
   </StackPanel>
  </Grid>
  <ListBox x:Name="Items" Grid.Row="3" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedItem}" HorizontalContentAlignment="Stretch"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource PanelBrush}" BorderThickness="0" AutomationProperties.Name="Imported artefact items" AutomationProperties.AutomationId="ArtifactItems">
   <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" Margin="10,14,10,6"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,5">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding EvidenceLevel}" TextWrapping="Wrap" Margin="0,3,0,0"/>
    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
  </ListBox>
  <Grid Grid.Row="4" Margin="0,14,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ArtifactStatus"/>
   <DockPanel Grid.Row="1">
    <Button DockPanel.Dock="Left" Content="Clear filters" Command="{Binding ResetCommand}" Padding="12,6" AutomationProperties.AutomationId="ArtifactReset"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="Close" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
     <Button Content="Open document" IsDefault="True" Command="{Binding OpenCommand}" Padding="16,6" AutomationProperties.AutomationId="OpenArtifactDocument"/>
    </StackPanel>
   </DockPanel>
  </Grid>
 </Grid>
</Window>
