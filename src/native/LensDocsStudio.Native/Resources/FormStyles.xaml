<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CommandIcons.xaml"/><ResourceDictionary Source="DesktopStyles.xaml"/></ResourceDictionary.MergedDictionaries>
 <Thickness x:Key="Form.FieldSpacing">0,0,0,16</Thickness>
 <Style x:Key="Form.Field" TargetType="StackPanel"><Setter Property="Margin" Value="{StaticResource Form.FieldSpacing}"/></Style>
 <Style x:Key="Form.Label" TargetType="Label"><Setter Property="Padding" Value="0,0,0,6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
 <Style x:Key="Form.Help" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="FontSize" Value="12"/></Style>
 <Style x:Key="Form.Section" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,14"/></Style>
 <Style x:Key="Form.Action" TargetType="Button" BasedOn="{StaticResource Desktop.CommandButton}"><Setter Property="Focusable" Value="True"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,6"/></Style>
 <Style x:Key="Form.PrimaryAction" TargetType="Button" BasedOn="{StaticResource Form.Action}"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="Form.Validation" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,10,0,12"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/></Style>
 <Style x:Key="Form.Progress" TargetType="ProgressBar"><Setter Property="Height" Value="3"/><Setter Property="IsIndeterminate" Value="True"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
</ResourceDictionary>
