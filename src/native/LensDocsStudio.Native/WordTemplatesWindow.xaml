<Window x:Class="LensDocsStudio.Native.WordTemplatesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Word template library" Width="760" Height="580" MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Word templates" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="Keep reusable formatting from your own DOCX files. Original files remain unchanged." TextWrapping="Wrap" Margin="0,0,0,8"/>
  </StackPanel>
  <TextBlock x:Name="CurrentStyles" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.AutomationId="CurrentWordTemplate"/>
  <WrapPanel Grid.Row="2" Margin="0,0,0,10">
   <Button x:Name="ImportButton" Content="Import…" Click="Import" Padding="12,6" Margin="0,0,6,6" AutomationProperties.AutomationId="ImportLibraryTemplate"/>
   <Button x:Name="RenameButton" Content="Rename…" Click="Rename" Padding="12,6" Margin="0,0,6,6" AutomationProperties.AutomationId="RenameLibraryTemplate"/>
   <Button x:Name="CopyButton" Content="Save copy…" Click="SaveCopy" Padding="12,6" Margin="0,0,6,6" AutomationProperties.AutomationId="CopyLibraryTemplate"/>
   <Button x:Name="ArchiveButton" Content="Archive" Click="ArchiveOrRestore" Padding="12,6" Margin="0,0,6,6" AutomationProperties.AutomationId="ArchiveLibraryTemplate"/>
   <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh" Padding="12,6" Margin="0,0,12,6" AutomationProperties.AutomationId="RefreshWordTemplates"/>
   <CheckBox x:Name="Archived" Content="Show archived" Checked="ViewChanged" Unchecked="ViewChanged" VerticalAlignment="Center" Margin="0,0,0,6" AutomationProperties.AutomationId="ShowArchivedTemplates"/>
  </WrapPanel>
  <ListBox x:Name="TemplateList" Grid.Row="3" SelectionChanged="SelectionChanged" HorizontalContentAlignment="Stretch"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved Word templates" AutomationProperties.AutomationId="WordTemplateList">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="4" Margin="0,10,0,12">
   <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" AutomationProperties.Name="Word template operation"/>
   <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="LibraryStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="WordTemplateStatus"/></ScrollViewer>
  </StackPanel>
  <WrapPanel Grid.Row="5" HorizontalAlignment="Right">
   <Button x:Name="CancelButton" Content="Cancel operation" IsEnabled="False" Click="CancelOperation" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="CancelTemplateOperation"/>
   <Button Content="Close" IsCancel="True" Padding="12,6" Margin="0,0,8,0"/>
   <Button x:Name="DefaultButton" Content="Use default styles" Click="UseDefault" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="DefaultLibraryTemplate"/>
   <Button x:Name="UseButton" Content="Use template" IsDefault="True" Click="UseSelected" Padding="12,6" AutomationProperties.AutomationId="UseLibraryTemplate"/>
  </WrapPanel>
 </Grid>
</Window>
