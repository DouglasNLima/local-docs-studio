<Window x:Class="LensDocsStudio.Native.UpdatesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Lens Docs Studio updates" Width="660" Height="570" MinWidth="520" MinHeight="430" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0"><TextBlock Text="Application updates" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentVersion, StringFormat='Installed version: {0}'}" Margin="0,8,0,16"/></StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
   <CheckBox Content="Check automatically while the app is running" IsChecked="{Binding AutomaticChecks}" IsEnabled="{Binding CanCheck}" VerticalAlignment="Center" AutomationProperties.AutomationId="AutomaticUpdateChecks"/>
   <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" IsEnabled="{Binding CanCheck}" Width="100" Margin="16,0,0,0" AutomationProperties.Name="Update channel" AutomationProperties.AutomationId="UpdateChannel"/>
  </StackPanel>
  <TextBlock Grid.Row="2" Text="{Binding AvailableVersion}" FontSize="18" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="3" Text="{Binding TrustSummary}" TextWrapping="Wrap" Margin="0,8,0,12"/>
  <TextBox Grid.Row="4" Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" AutomationProperties.Name="Release notes"/>
  <StackPanel Grid.Row="5" Margin="0,12"><ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <WrapPanel Grid.Row="6">
   <Button Content="Check now" Command="{Binding CheckNowCommand}" Padding="10,6" Margin="0,0,6,6"/>
   <Button Content="Release page" Command="{Binding OpenReleaseCommand}" Padding="10,6" Margin="0,0,6,6"/>
   <Button Content="Ignore version" Command="{Binding IgnoreCommand}" Padding="10,6" Margin="0,0,6,6"/>
   <Button Content="Download" Command="{Binding DownloadCommand}" Padding="10,6" Margin="0,0,6,6" AutomationProperties.AutomationId="DownloadUpdate"/>
   <Button Content="Install…" Command="{Binding InstallCommand}" Padding="10,6" Margin="0,0,6,6" AutomationProperties.AutomationId="InstallUpdate"/>
   <Button Content="Cancel operation" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Padding="10,6" Margin="0,0,6,6"/>
   <Button Content="Later" Click="Postpone" Padding="10,6" Margin="0,0,6,6"/>
  </WrapPanel>
 </Grid>
</Window>
