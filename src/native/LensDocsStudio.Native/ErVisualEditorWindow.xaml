<Window x:Class="LensDocsStudio.Native.ErVisualEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:ui="clr-namespace:LensDocsStudio.Native.Controls"
 Title="Mermaid Visual Editor / ER" Width="1280" Height="800" MinWidth="880" MinHeight="600"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="Segoe UI" FontSize="12" Icon="Resources/Brand/application.ico" UseLayoutRounding="True"
 AutomationProperties.AutomationId="ErVisualEditor" PreviewKeyDown="Shortcut">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/MermaidEditorStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
   <StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="Mermaid" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Mermaid Visual Editor" FontSize="14" FontWeight="SemiBold" Margin="8,0"/><TextBlock Text="/ ER" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/></StackPanel>
  </Border>
  <ToolBar DockPanel.Dock="Top" Style="{StaticResource Desktop.DiagramToolbar}" AutomationProperties.Name="ER commands">
   <Button x:Name="UndoButton" Click="Undo" Style="{StaticResource Mermaid.ToolbarButton}" ToolTip="Undo visual edit (Ctrl+Z)" AutomationProperties.AutomationId="ErUndo"><ui:CommandIcon Kind="Undo"/></Button>
   <Button x:Name="RedoButton" Click="Redo" Style="{StaticResource Mermaid.ToolbarButton}" ToolTip="Redo visual edit (Ctrl+Y)" AutomationProperties.AutomationId="ErRedo"><ui:CommandIcon Kind="Redo"/></Button>
   <Separator/>
   <Button x:Name="DeleteButton" Click="Delete" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="ErDelete" ToolTip="Delete selection (Delete)" AutomationProperties.Name="Delete selection (Delete)"><ui:CommandIcon Kind="Delete"/></Button>
   <Button x:Name="DuplicateButton" Click="Duplicate" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="ErDuplicate" ToolTip="Duplicate selection (Ctrl+D)" AutomationProperties.Name="Duplicate selection (Ctrl+D)"><ui:CommandIcon Kind="Duplicate"/></Button>
   <Button x:Name="ReverseButton" Content="Reverse" Click="Reverse" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="ErReverse" AutomationProperties.Name="Reverse relationship and retain endpoint cardinalities" ToolTip="Reverse selected relationship"/>
   <Separator/>
   <Button Click="ZoomOut" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="ErZoomOut" ToolTip="Zoom out (Ctrl+wheel)" AutomationProperties.Name="Zoom out (Ctrl+wheel)"><ui:CommandIcon Kind="ZoomOut"/></Button>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolBar.OverflowMode="Never"><Slider x:Name="Zoom" Width="80" Minimum="0.1" Maximum="400" Value="100" ValueChanged="ZoomChanged" AutomationProperties.Name="Canvas zoom percentage" AutomationProperties.AutomationId="ErZoom"/><TextBlock Text="{Binding Value, ElementName=Zoom, StringFormat={}{0:0.###}%}" MinWidth="40" Margin="6,0" VerticalAlignment="Center" AutomationProperties.Name="Current canvas zoom"/></StackPanel>
   <Button Click="ZoomIn" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="ErZoomIn" ToolTip="Zoom in (Ctrl+wheel)" AutomationProperties.Name="Zoom in (Ctrl+wheel)"><ui:CommandIcon Kind="ZoomIn"/></Button>
   <Button Click="Fit" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="ErFit" ToolTip="Fit diagram (F)" AutomationProperties.Name="Fit diagram (F)"><ui:CommandIcon Kind="Focus"/></Button>
   <Button Click="ActualSize" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="ErActualSize" ToolTip="Actual size (Ctrl+0)" AutomationProperties.Name="Actual size (Ctrl+0)"><ui:CommandIcon Kind="Selection"/></Button>
   <Button Click="AutoLayout" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="ErAutoLayout" ToolTip="Centre canonical layout" AutomationProperties.Name="Centre canonical layout"><ui:CommandIcon Kind="AutoLayout"/></Button>
   <Button Click="Preview" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="ErPreview" ToolTip="Rendered preview" AutomationProperties.Name="Rendered preview"><ui:CommandIcon Kind="Preview"/></Button>
  </ToolBar>
  <Border DockPanel.Dock="Bottom" Padding="12,8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Status" Text="Preparing ER diagram…" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="ErStatus" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="EditSourceButton" Content="Edit source" Click="EditSource" Style="{StaticResource Form.Action}" Margin="0,0,8,0" AutomationProperties.AutomationId="ErEditSource"/>
     <Button Content="Cancel" Click="Cancel" Style="{StaticResource Form.Action}" AutomationProperties.AutomationId="ErCancel"/>
     <Button x:Name="ApplyButton" Content="Apply" Click="Apply" Style="{StaticResource Mermaid.PrimaryAction}" ToolTip="Apply as one document Undo action (Ctrl+Enter)" AutomationProperties.AutomationId="ErApply"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="180"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="6"/><ColumnDefinition Width="310" MinWidth="240"/></Grid.ColumnDefinitions>
   <DockPanel Background="{DynamicResource PanelBrush}">
    <StackPanel DockPanel.Dock="Top" Margin="8">
     <TextBlock Text="ER PALETTE" Style="{StaticResource Desktop.PanelHeading}"/>
     <Button x:Name="AddEntityButton" Content="Add entity" Click="AddEntity" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="ErAddEntity"/>
     <Button x:Name="AddRelationshipButton" Content="Add relationship" Click="AddRelationship" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="ErAddRelationship"/>
     <TextBlock Text="ENTITIES AND RELATIONSHIPS" Style="{StaticResource Desktop.PanelHeading}" Margin="0,12,0,4"/>
    </StackPanel>
    <ListBox Style="{StaticResource Mermaid.Navigation}" x:Name="Elements" SelectionChanged="SelectionChanged" AutomationProperties.Name="Entities, attributes and exact relationship occurrences" AutomationProperties.AutomationId="ErElements"><ListBox.GroupStyle><StaticResource ResourceKey="Mermaid.NavigationGroup"/></ListBox.GroupStyle></ListBox>
   </DockPanel>
   <GridSplitter Style="{StaticResource Mermaid.Splitter}" Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize navigation panel" AutomationProperties.AutomationId="ErNavigationSplitter"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="6"/><RowDefinition Height="40" MinHeight="40"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBrush}" PreviewMouseWheel="Wheel" PreviewMouseDown="PanStart" PreviewMouseMove="PanMove" PreviewMouseUp="PanEnd" Focusable="True" AutomationProperties.Name="ER diagram; middle mouse pans, arrow keys scroll" AutomationProperties.AutomationId="ErViewport">
     <Canvas x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" PreviewMouseLeftButtonDown="CanvasPointer">
      <Canvas.LayoutTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform>
     </Canvas>
    </ScrollViewer>
    <GridSplitter Style="{StaticResource Mermaid.Splitter}" Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Resize source panel" AutomationProperties.AutomationId="ErSourceSplitter"/>
    <Expander ui:MermaidWorkspace.AdjustableSource="True" x:Name="SourcePanel" Grid.Row="2" Header="Portable Mermaid source and validation" IsExpanded="False" Style="{StaticResource Mermaid.SourcePanel}" AutomationProperties.AutomationId="ErSourcePanel">
     <DockPanel>
      <WrapPanel DockPanel.Dock="Top">
       <Button x:Name="ValidateButton" Content="Validate source" Click="ValidateSource" Style="{StaticResource Form.Action}" AutomationProperties.AutomationId="ErValidate"/>
       <Button Content="Original source" Click="ShowOriginal" Style="{StaticResource Form.Action}" AutomationProperties.AutomationId="ErOriginal"/>
       <Button Click="CopySource" Style="{StaticResource Mermaid.ToolbarButton}" ToolTip="Copy Mermaid draft source" AutomationProperties.AutomationId="ErCopySource"><ui:CommandIcon Kind="Copy"/></Button>
      </WrapPanel>
      <edit:TextEditor x:Name="SourceEditor" ShowLineNumbers="True" LineNumbersForeground="{DynamicResource MutedTextBrush}" WordWrap="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" TextChanged="SourceChanged" AutomationProperties.Name="ER draft source" AutomationProperties.AutomationId="ErSource"/>
     </DockPanel>
    </Expander>
   </Grid>
   <GridSplitter Style="{StaticResource Mermaid.Splitter}" Grid.Column="3" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize inspector panel" AutomationProperties.AutomationId="ErInspectorSplitter"/>
   <ui:MermaidInspectorPanel Grid.Column="4" Background="{DynamicResource PanelBrush}" AutomationProperties.Name="Selected element properties" AutomationProperties.AutomationId="ErInspectorPanel">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="12,10,12,6"><TextBlock Text="INSPECTOR" Style="{StaticResource Desktop.PanelHeading}"/>
     <TextBlock x:Name="Summary" Text="Select an entity, attribute or relationship." Style="{StaticResource Mermaid.InspectorHeading}" AutomationProperties.AutomationId="ErSelectionSummary"/>
     <TextBlock x:Name="ContextDescription" Style="{StaticResource Mermaid.InspectorDescription}" AutomationProperties.AutomationId="ErSelectionDescription"/>
     <TextBlock x:Name="InspectorState" Text="Ready" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.AutomationId="ErInspectorState" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="InspectorViewport" AutomationProperties.AutomationId="ErInspectorViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,0,12,12">
     <TextBlock x:Name="Dependencies" TextWrapping="Wrap" Style="{StaticResource Form.Help}" AutomationProperties.AutomationId="ErDependencies"/>
     <StackPanel x:Name="NodeFields" Visibility="Collapsed">
      <Label Content="_ID" Target="{Binding ElementName=NodeId}" Style="{StaticResource Form.Label}"/>
      <TextBox x:Name="NodeId" Style="{StaticResource Mermaid.PropertyInput}" AutomationProperties.Name="Entity ID" AutomationProperties.AutomationId="ErNodeId"/>
     </StackPanel>
     <StackPanel x:Name="TransitionFields" Visibility="Collapsed">
      <Label Content="_First entity" Target="{Binding ElementName=From}" Style="{StaticResource Form.Label}"/>
      <ComboBox x:Name="From" Style="{StaticResource Form.ComboBox}" DisplayMemberPath="Description" SelectedValuePath="Identity" AutomationProperties.Name="First relationship entity" AutomationProperties.AutomationId="ErFrom"/>
      <Label Content="_Second entity" Target="{Binding ElementName=To}" Style="{StaticResource Form.Label}"/>
      <ComboBox x:Name="To" Style="{StaticResource Form.ComboBox}" DisplayMemberPath="Description" SelectedValuePath="Identity" AutomationProperties.Name="Second relationship entity" AutomationProperties.AutomationId="ErTo"/>
      <Label Content="Cardinality at first entity" Target="{Binding ElementName=FirstCardinality}" Style="{StaticResource Form.Label}"/>
      <ComboBox x:Name="FirstCardinality" Style="{StaticResource Form.ComboBox}" DisplayMemberPath="Description" SelectedValuePath="Value" AutomationProperties.Name="Cardinality at first entity" AutomationProperties.AutomationId="ErFirstCardinality"/>
      <Label Content="Cardinality at second entity" Target="{Binding ElementName=SecondCardinality}" Style="{StaticResource Form.Label}"/>
      <ComboBox x:Name="SecondCardinality" Style="{StaticResource Form.ComboBox}" DisplayMemberPath="Description" SelectedValuePath="Value" AutomationProperties.Name="Cardinality at second entity" AutomationProperties.AutomationId="ErSecondCardinality"/>
      <Label Content="Relationship type" Target="{Binding ElementName=RelationshipType}" Style="{StaticResource Form.Label}"/>
      <ComboBox x:Name="RelationshipType" Style="{StaticResource Form.ComboBox}" DisplayMemberPath="Description" SelectedValuePath="Value" AutomationProperties.Name="Identifying or non-identifying relationship" AutomationProperties.AutomationId="ErRelationshipType"/>
      <TextBlock Text="Cardinality belongs to its entity. Reverse keeps cardinalities with their entities. Pick endpoints on canvas or drag a selected endpoint to another entity." TextWrapping="Wrap" Style="{StaticResource Form.Help}"/>
      <Button x:Name="ReconnectFromButton" Content="Pick source on canvas" Click="ReconnectFrom" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="ErReconnectFrom"/>
      <Button x:Name="ReconnectToButton" Content="Pick destination on canvas" Click="ReconnectTo" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="ErReconnectTo"/>
     </StackPanel>
     <StackPanel x:Name="LabelFields" Visibility="Collapsed">
      <Label Content="_Label" Target="{Binding ElementName=LabelText}" Style="{StaticResource Form.Label}"/>
      <TextBox x:Name="LabelText" Style="{StaticResource Mermaid.PropertyInput}" TextWrapping="Wrap" AutomationProperties.Name="Selected ER element label" AutomationProperties.AutomationId="ErLabel"/>
     </StackPanel>

     <StackPanel x:Name="AttributeFields" Visibility="Collapsed">
      <Label Content="Attribute type" Target="{Binding ElementName=AttributeType}" Style="{StaticResource Form.Label}"/>
      <TextBox x:Name="AttributeType" Style="{StaticResource Mermaid.PropertyInput}" AutomationProperties.Name="Attribute type" AutomationProperties.AutomationId="ErAttributeType"/>
      <Label Content="Attribute name" Target="{Binding ElementName=AttributeName}" Style="{StaticResource Form.Label}"/>
      <TextBox x:Name="AttributeName" Style="{StaticResource Mermaid.PropertyInput}" AutomationProperties.Name="Attribute name" AutomationProperties.AutomationId="ErAttributeName"/>
      <StackPanel Orientation="Horizontal" Margin="0,6"><CheckBox x:Name="PrimaryKey" Style="{StaticResource Form.CheckBox}" Width="60" MinWidth="0" Padding="0" HorizontalAlignment="Left" Content="PK" Margin="0,0,12,0" AutomationProperties.Name="Primary key documentation marker" AutomationProperties.AutomationId="ErPK"/><CheckBox x:Name="ForeignKey" Style="{StaticResource Form.CheckBox}" Width="60" MinWidth="0" Padding="0" HorizontalAlignment="Left" Content="FK" Margin="0,0,12,0" AutomationProperties.Name="Foreign key documentation marker" AutomationProperties.AutomationId="ErFK"/><CheckBox x:Name="UniqueKey" Margin="0" Style="{StaticResource Form.CheckBox}" Width="60" MinWidth="0" Padding="0" HorizontalAlignment="Left" Content="UK" AutomationProperties.Name="Unique key documentation marker" AutomationProperties.AutomationId="ErUK"/></StackPanel>
      <Label Content="Attribute comment" Target="{Binding ElementName=AttributeComment}" Style="{StaticResource Form.Label}"/>
      <TextBox x:Name="AttributeComment" Style="{StaticResource Mermaid.PropertyInput}" AutomationProperties.Name="Attribute comment" AutomationProperties.AutomationId="ErAttributeComment"/>
      <TextBlock Text="PK, FK and UK are Mermaid documentation markers. They do not enforce database constraints or create relationships." Style="{StaticResource Form.Help}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal"><Button x:Name="MoveUpButton" Content="Move up" Click="MoveUp" Style="{StaticResource Form.Action}" AutomationProperties.AutomationId="ErMoveUp"/><Button x:Name="MoveDownButton" Content="Move down" Click="MoveDown" Style="{StaticResource Form.Action}" AutomationProperties.AutomationId="ErMoveDown"/></StackPanel>
     </StackPanel>
     <StackPanel x:Name="AttributesPanel" Visibility="Collapsed">
      <TextBlock Text="ATTRIBUTES" Style="{StaticResource Desktop.PanelHeading}" Margin="0,12,0,4"/>
      <ListView x:Name="AttributeRows" SelectionChanged="AttributeSelected" MaxHeight="170" AutomationProperties.Name="Entity attributes in source order" AutomationProperties.AutomationId="ErAttributeRows">
       <ListView.View><GridView><GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="65"/><GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="90"/><GridViewColumn Header="Keys" DisplayMemberBinding="{Binding Keys}" Width="50"/><GridViewColumn Header="Comment" DisplayMemberBinding="{Binding Comment}" Width="120"/></GridView></ListView.View>
      </ListView>
      <Button x:Name="AddAttributeButton" Content="Add attribute" Click="AddAttribute" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="ErAddAttribute"/>
     </StackPanel>
     <TextBlock x:Name="Capabilities" TextWrapping="Wrap" Style="{StaticResource Form.Help}" Margin="0,10" AutomationProperties.AutomationId="ErCapabilities"/>
     <Button Content="Locate in source" Click="LocateSource" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="ErLocateSource"/>
    </StackPanel>
   </ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="12,8">
     <Button x:Name="UpdateButton" Content="Update properties" Click="Update" Style="{StaticResource Mermaid.PrimaryAction}" HorizontalAlignment="Left" Margin="0,0,8,0" AutomationProperties.AutomationId="ErUpdate"/>
     <Button x:Name="ResetButton" Content="Reset changes" Click="ResetProperties" Style="{StaticResource Form.Action}" ToolTip="Reset unapplied property changes" AutomationProperties.AutomationId="ErResetProperties"/>
    </WrapPanel>
    </Grid>
   </ui:MermaidInspectorPanel>
  </Grid>
 </DockPanel>
</Window>
