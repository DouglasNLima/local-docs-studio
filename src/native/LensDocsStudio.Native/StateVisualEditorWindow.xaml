<Window x:Class="LensDocsStudio.Native.StateVisualEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:ui="clr-namespace:LensDocsStudio.Native.Controls"
 Title="Mermaid Visual Editor / State" Width="1280" Height="800" MinWidth="880" MinHeight="600"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="Segoe UI" FontSize="12" Icon="Resources/Brand/application.ico" UseLayoutRounding="True"
 AutomationProperties.AutomationId="StateVisualEditor" PreviewKeyDown="Shortcut">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/MermaidEditorStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
   <StackPanel Orientation="Horizontal"><ui:CommandIcon Kind="Mermaid" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Mermaid Visual Editor" FontSize="14" FontWeight="SemiBold" Margin="8,0"/><TextBlock Text="/ State" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/></StackPanel>
  </Border>
  <ToolBar DockPanel.Dock="Top" Style="{StaticResource Desktop.DiagramToolbar}" AutomationProperties.Name="State commands">
   <Button x:Name="UndoButton" Click="Undo" Style="{StaticResource Mermaid.ToolbarButton}" ToolTip="Undo visual edit (Ctrl+Z)" AutomationProperties.AutomationId="StateUndo"><ui:CommandIcon Kind="Undo"/></Button>
   <Button x:Name="RedoButton" Click="Redo" Style="{StaticResource Mermaid.ToolbarButton}" ToolTip="Redo visual edit (Ctrl+Y)" AutomationProperties.AutomationId="StateRedo"><ui:CommandIcon Kind="Redo"/></Button>
   <Separator/>
   <Button x:Name="DeleteButton" Click="Delete" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="StateDelete" ToolTip="Delete selection (Delete)" AutomationProperties.Name="Delete selection (Delete)"><ui:CommandIcon Kind="Delete"/></Button>
   <Button x:Name="DuplicateButton" Click="Duplicate" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="StateDuplicate" ToolTip="Duplicate selection (Ctrl+D)" AutomationProperties.Name="Duplicate selection (Ctrl+D)"><ui:CommandIcon Kind="Duplicate"/></Button>
   <Button x:Name="ReverseButton" Content="Reverse" Click="Reverse" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="StateReverse" AutomationProperties.Name="Reverse selected transition" ToolTip="Reverse selected relationship"/>
   <Separator/>
   <Button Click="ZoomOut" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="StateZoomOut" ToolTip="Zoom out (Ctrl+wheel)" AutomationProperties.Name="Zoom out (Ctrl+wheel)"><ui:CommandIcon Kind="ZoomOut"/></Button>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolBar.OverflowMode="Never"><Slider x:Name="Zoom" Width="80" Minimum="0.1" Maximum="400" Value="100" ValueChanged="ZoomChanged" AutomationProperties.Name="Canvas zoom percentage" AutomationProperties.AutomationId="StateZoom"/><TextBlock Text="{Binding Value, ElementName=Zoom, StringFormat={}{0:0.#}%}" MinWidth="40" Margin="6,0" VerticalAlignment="Center" AutomationProperties.Name="Current canvas zoom"/></StackPanel>
   <Button Click="ZoomIn" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="StateZoomIn" ToolTip="Zoom in (Ctrl+wheel)" AutomationProperties.Name="Zoom in (Ctrl+wheel)"><ui:CommandIcon Kind="ZoomIn"/></Button>
   <Button Click="Fit" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="StateFit" ToolTip="Fit diagram (F)" AutomationProperties.Name="Fit diagram (F)"><ui:CommandIcon Kind="Focus"/></Button>
   <Button Click="ActualSize" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="StateActualSize" ToolTip="Actual size (Ctrl+0)" AutomationProperties.Name="Actual size (Ctrl+0)"><ui:CommandIcon Kind="Selection"/></Button>
   <Button Click="AutoLayout" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="StateAutoLayout" ToolTip="Restore canonical layout" AutomationProperties.Name="Restore canonical layout"><ui:CommandIcon Kind="AutoLayout"/></Button>
   <Button Click="ToggleSource" Style="{StaticResource Mermaid.ToolbarButton}" ToolTip="Show or hide Mermaid source" AutomationProperties.Name="Show or hide Mermaid source" AutomationProperties.AutomationId="StateToggleSource"><ui:CommandIcon Kind="Code"/></Button>
   <Button Click="Preview" Style="{StaticResource Mermaid.ToolbarButton}" AutomationProperties.AutomationId="StatePreview" ToolTip="Rendered preview" AutomationProperties.Name="Rendered preview"><ui:CommandIcon Kind="Preview"/></Button>
  </ToolBar>
  <Border DockPanel.Dock="Bottom" Padding="12,8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Status" Text="Preparing State diagram…" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="StateStatus" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="EditSourceButton" Content="Edit source" Click="EditSource" Style="{StaticResource Form.Action}" Margin="0,0,8,0" AutomationProperties.AutomationId="StateEditSource"/>
     <Button Content="Cancel" Click="Cancel" Style="{StaticResource Form.Action}" AutomationProperties.AutomationId="StateCancel"/>
     <Button x:Name="ApplyButton" Content="Apply" Click="Apply" Style="{StaticResource Mermaid.PrimaryAction}" ToolTip="Apply as one document Undo action (Ctrl+Enter)" AutomationProperties.AutomationId="StateApply"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="180"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="6"/><ColumnDefinition Width="260" MinWidth="220"/></Grid.ColumnDefinitions>
   <DockPanel Background="{DynamicResource PanelBrush}">
    <StackPanel DockPanel.Dock="Top" Margin="8">
     <TextBlock Text="STATE PALETTE" Style="{StaticResource Desktop.PanelHeading}"/>
     <Button x:Name="AddStateButton" Content="Add state" Click="AddState" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="StateAddState"/>
     <Button x:Name="AddTransitionButton" Content="Add transition" Click="AddTransition" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="StateAddTransition"/>
     <Button x:Name="InitialButton" Content="Connect initial state" Click="AddInitial" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="StateAddInitial"/>
     <Button x:Name="FinalButton" Content="Connect final state" Click="AddFinal" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="StateAddFinal"/>
     <TextBlock Text="STATES AND TRANSITIONS" Style="{StaticResource Desktop.PanelHeading}" Margin="0,12,0,4"/>
    </StackPanel>
    <ListBox Style="{StaticResource Mermaid.Navigation}" x:Name="Elements" SelectionChanged="SelectionChanged" AutomationProperties.Name="States, scoped markers, composite groups and exact transition occurrences" AutomationProperties.AutomationId="StateElements"><ListBox.GroupStyle><StaticResource ResourceKey="Mermaid.NavigationGroup"/></ListBox.GroupStyle></ListBox>
   </DockPanel>
   <GridSplitter Style="{StaticResource Mermaid.Splitter}" Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize navigation panel" AutomationProperties.AutomationId="StateNavigationSplitter"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="6"/><RowDefinition Height="40" MinHeight="40"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBrush}" PreviewMouseWheel="Wheel" PreviewMouseDown="PanStart" PreviewMouseMove="PanMove" PreviewMouseUp="PanEnd" Focusable="True" AutomationProperties.Name="State diagram; middle mouse pans, arrow keys scroll" AutomationProperties.AutomationId="StateViewport">
     <Canvas x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" PreviewMouseLeftButtonDown="CanvasPointer">
      <Canvas.LayoutTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform>
     </Canvas>
    </ScrollViewer>
    <GridSplitter Style="{StaticResource Mermaid.Splitter}" Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Resize source panel" AutomationProperties.AutomationId="StateSourceSplitter"/>
    <Expander ui:MermaidWorkspace.AdjustableSource="True" x:Name="SourcePanel" Grid.Row="2" Header="Portable Mermaid source and validation" IsExpanded="False" Style="{StaticResource Mermaid.SourcePanel}" AutomationProperties.AutomationId="StateSourcePanel">
     <DockPanel>
      <WrapPanel DockPanel.Dock="Top">
       <Button x:Name="ValidateButton" Content="Validate source" Click="ValidateSource" Style="{StaticResource Form.Action}" AutomationProperties.AutomationId="StateValidate"/>
       <Button Content="Original source" Click="ShowOriginal" Style="{StaticResource Form.Action}" AutomationProperties.AutomationId="StateOriginal"/>
       <Button Click="CopySource" Style="{StaticResource Mermaid.ToolbarButton}" ToolTip="Copy Mermaid draft source" AutomationProperties.AutomationId="StateCopySource"><ui:CommandIcon Kind="Copy"/></Button>
      </WrapPanel>
      <edit:TextEditor x:Name="SourceEditor" ShowLineNumbers="True" LineNumbersForeground="{DynamicResource MutedTextBrush}" WordWrap="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" TextChanged="SourceChanged" AutomationProperties.Name="State draft source" AutomationProperties.AutomationId="StateSource"/>
     </DockPanel>
    </Expander>
   </Grid>
   <GridSplitter Style="{StaticResource Mermaid.Splitter}" Grid.Column="3" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize inspector panel" AutomationProperties.AutomationId="StateInspectorSplitter"/>
   <ui:MermaidInspectorPanel Grid.Column="4" Background="{DynamicResource PanelBrush}" AutomationProperties.Name="Selected element properties" AutomationProperties.AutomationId="StateInspectorPanel">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="12,10,12,6"><TextBlock Text="INSPECTOR" Style="{StaticResource Desktop.PanelHeading}"/>
     <TextBlock x:Name="Summary" Text="Select a state or transition." Style="{StaticResource Mermaid.InspectorHeading}" AutomationProperties.AutomationId="StateSelectionSummary"/>
     <TextBlock x:Name="ContextDescription" Style="{StaticResource Mermaid.InspectorDescription}" AutomationProperties.AutomationId="StateSelectionDescription"/>
     <TextBlock x:Name="InspectorState" Text="Ready" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.AutomationId="StateInspectorState" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="InspectorViewport" AutomationProperties.AutomationId="StateInspectorViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,0,12,12">
     <TextBlock x:Name="Dependencies" TextWrapping="Wrap" Style="{StaticResource Form.Help}" AutomationProperties.AutomationId="StateDependencies"/>
     <StackPanel x:Name="NodeFields" Visibility="Collapsed">
      <Label Content="_ID" Target="{Binding ElementName=NodeId}" Style="{StaticResource Form.Label}"/>
      <TextBox x:Name="NodeId" Style="{StaticResource Mermaid.PropertyInput}" AutomationProperties.Name="State ID" AutomationProperties.AutomationId="StateNodeId"/>
     </StackPanel>
     <StackPanel x:Name="TransitionFields" Visibility="Collapsed">
      <Label Content="_Source state" Target="{Binding ElementName=From}" Style="{StaticResource Form.Label}"/>
      <ComboBox x:Name="From" Style="{StaticResource Form.ComboBox}" DisplayMemberPath="Description" SelectedValuePath="Identity" AutomationProperties.Name="Transition source state" AutomationProperties.AutomationId="StateFrom"/>
      <Label Content="_Destination state" Target="{Binding ElementName=To}" Style="{StaticResource Form.Label}"/>
      <ComboBox x:Name="To" Style="{StaticResource Form.ComboBox}" DisplayMemberPath="Description" SelectedValuePath="Identity" AutomationProperties.Name="Transition destination state" AutomationProperties.AutomationId="StateTo"/>
      <TextBlock Text="Connect on canvas: choose source, then destination. Self-transitions are supported." TextWrapping="Wrap" Style="{StaticResource Form.Help}"/>
      <Button x:Name="ReconnectFromButton" Content="Pick source on canvas" Click="ReconnectFrom" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="StateReconnectFrom"/>
      <Button x:Name="ReconnectToButton" Content="Pick destination on canvas" Click="ReconnectTo" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="StateReconnectTo"/>
     </StackPanel>
     <StackPanel x:Name="LabelFields" Visibility="Collapsed">
      <Label Content="_Label" Target="{Binding ElementName=LabelText}" Style="{StaticResource Form.Label}"/>
      <TextBox x:Name="LabelText" Style="{StaticResource Mermaid.PropertyInput}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected State element label" AutomationProperties.AutomationId="StateLabel"/>
     </StackPanel>
     <TextBlock x:Name="Capabilities" TextWrapping="Wrap" Style="{StaticResource Form.Help}" Margin="0,10" AutomationProperties.AutomationId="StateCapabilities"/>
     <Button Content="Locate in source" Click="LocateSource" Style="{StaticResource Mermaid.Action}" AutomationProperties.AutomationId="StateLocateSource"/>
    </StackPanel>
   </ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="12,8">
     <Button x:Name="UpdateButton" Content="Update properties" Click="Update" Style="{StaticResource Mermaid.PrimaryAction}" HorizontalAlignment="Left" Margin="0,0,8,0" AutomationProperties.AutomationId="StateUpdate"/>
     <Button x:Name="ResetButton" Content="Reset changes" Click="ResetProperties" Style="{StaticResource Form.Action}" ToolTip="Reset unapplied property changes" AutomationProperties.AutomationId="StateResetProperties"/>
    </WrapPanel>
    </Grid>
   </ui:MermaidInspectorPanel>
  </Grid>
 </DockPanel>
</Window>
