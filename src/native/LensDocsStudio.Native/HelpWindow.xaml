<Window x:Class="LensDocsStudio.Native.HelpWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Native guide" Width="980" Height="760" MinWidth="680" MinHeight="520" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" PreviewKeyDown="GuideKeyDown">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Lens Docs Studio guide" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <DockPanel Grid.Row="1" Margin="0,0,0,16">
   <Label Content="_Find a topic" Target="{Binding ElementName=Query}" VerticalAlignment="Center"/>
   <TextBox x:Name="Query" MaxLength="256" Padding="8,5" TextChanged="QueryChanged" AutomationProperties.Name="Find a help topic" AutomationProperties.AutomationId="HelpQuery"/>
  </DockPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Topics" SelectionChanged="TopicSelected" Background="{DynamicResource PanelBrush}" BorderThickness="0"
    HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Guide topics" AutomationProperties.AutomationId="HelpTopics">
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="6,7"/></DataTemplate></ListBox.ItemTemplate>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
   </ListBox>
   <FlowDocumentScrollViewer x:Name="ContentViewer" Grid.Column="2" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBrush}"
    AutomationProperties.Name="Help content" AutomationProperties.AutomationId="HelpContent"/>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,14,0,0">
   <Button DockPanel.Dock="Right" Content="Close" Click="CloseGuide" Padding="16,6" AutomationProperties.AutomationId="CloseHelp"/>
   <TextBlock x:Name="Status" Text="Bundled offline guide · Ctrl+F to find a topic" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HelpStatus"/>
  </DockPanel>
 </Grid>
</Window>
