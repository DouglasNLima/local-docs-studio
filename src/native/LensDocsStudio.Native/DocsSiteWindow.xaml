<Window x:Class="LensDocsStudio.Native.DocsSiteWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Export Docs Site" Width="650" Height="620" MinWidth="500" MinHeight="420" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/FormStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
   <StackPanel>
    <TextBlock Text="Create a portable documentation site" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="Export the open workspace with navigation, search and embedded local images. Open the ZIP's index.html directly or publish its contents on GitHub Pages." Style="{StaticResource Form.Help}" Margin="0,0,0,16"/>
    <StackPanel Style="{StaticResource Form.Field}">
     <Label Content="Site _title" Target="{Binding ElementName=SiteTitle}" Style="{StaticResource Form.Label}"/>
     <TextBox x:Name="SiteTitle" Padding="8" MaxLength="512" AutomationProperties.Name="Site title" AutomationProperties.AutomationId="DocsSiteTitle"/>
    </StackPanel>
    <StackPanel Style="{StaticResource Form.Field}">
     <Label Content="_Description" Target="{Binding ElementName=SiteDescription}" Style="{StaticResource Form.Label}"/>
     <TextBox x:Name="SiteDescription" Padding="8" MaxLength="8192" Height="76" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Site description"/>
    </StackPanel>
    <StackPanel Style="{StaticResource Form.Field}">
     <Label Content="Default t_heme" Target="{Binding ElementName=SiteTheme}" Style="{StaticResource Form.Label}"/>
     <ComboBox x:Name="SiteTheme" SelectedIndex="0" MinHeight="32" AutomationProperties.Name="Default site theme"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
     <TextBlock Text="Current edits to saved workspace documents are included. Save new drafts inside the workspace to include them. Private native state is excluded." Style="{StaticResource Form.Help}"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <TextBlock x:Name="ValidationMessage" Grid.Row="1" Style="{StaticResource Form.Validation}"/>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Style="{StaticResource Form.Action}"/>
   <Button Content="Choose ZIP destination…" IsDefault="True" Click="Accept" Style="{StaticResource Form.PrimaryAction}" AutomationProperties.AutomationId="ConfirmDocsSite"/>
  </WrapPanel>
 </Grid>
</Window>
