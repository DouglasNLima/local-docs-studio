<Window x:Class="LensDocsStudio.Native.DocsSiteWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Export Docs Site" Width="650" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="24">
  <TextBlock Text="Create a portable documentation site" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBlock Text="Export the open workspace with navigation, search and embedded local images. Open the ZIP's index.html directly or publish its contents on GitHub Pages." TextWrapping="Wrap" Margin="0,0,0,16"/>
  <Label Content="Site _title" Target="{Binding ElementName=SiteTitle}"/>
  <TextBox x:Name="SiteTitle" Padding="8" MaxLength="512" AutomationProperties.Name="Site title" AutomationProperties.AutomationId="DocsSiteTitle"/>
  <Label Content="_Description" Target="{Binding ElementName=SiteDescription}" Margin="0,10,0,0"/>
  <TextBox x:Name="SiteDescription" Padding="8" MaxLength="8192" Height="76" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Site description"/>
  <Label Content="Default t_heme" Target="{Binding ElementName=SiteTheme}" Margin="0,10,0,0"/>
  <ComboBox x:Name="SiteTheme" SelectedIndex="0" AutomationProperties.Name="Default site theme"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
  <TextBlock Text="Current edits to saved workspace documents are included. Save new drafts inside the workspace to include them. Private native state is excluded." TextWrapping="Wrap" Margin="0,16,0,12"/>
  <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/>
   <Button Content="Choose ZIP destination…" IsDefault="True" Click="Accept" Padding="14,6" AutomationProperties.AutomationId="ConfirmDocsSite"/>
  </StackPanel>
 </StackPanel>
</Window>
