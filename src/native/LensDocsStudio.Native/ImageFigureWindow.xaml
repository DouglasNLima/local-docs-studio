<Window x:Class="LensDocsStudio.Native.ImageFigureWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Image figure" Width="580" Height="510" MinWidth="440" MinHeight="380" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/FormStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
   <StackPanel>
    <TextBlock Text="Image description and caption" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock x:Name="ImageReference" TextTrimming="CharacterEllipsis" Margin="0,0,0,16" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Image location"/>
    <StackPanel Style="{StaticResource Form.Field}">
     <Label Content="_Alternative text" Target="{Binding ElementName=AlternativeText}" Style="{StaticResource Form.Label}"/>
     <TextBox x:Name="AlternativeText" Padding="8" MaxLength="4096" AutomationProperties.Name="Image alternative text" AutomationProperties.AutomationId="FigureAlternativeText"/>
     <TextBlock Text="Describe the image for readers who cannot see it." Style="{StaticResource Form.Help}"/>
    </StackPanel>
    <StackPanel Style="{StaticResource Form.Field}">
     <Label Content="_Caption" Target="{Binding ElementName=Caption}" Style="{StaticResource Form.Label}"/>
     <TextBox x:Name="Caption" Padding="8" MaxLength="4096" AutomationProperties.Name="Image caption" AutomationProperties.AutomationId="FigureCaption"/>
     <TextBlock Text="A caption appears beneath the image. Leave it empty to omit the caption." Style="{StaticResource Form.Help}"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <TextBlock x:Name="ValidationMessage" Grid.Row="1" Style="{StaticResource Form.Validation}" AutomationProperties.AutomationId="FigureValidation"/>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Style="{StaticResource Form.Action}"/>
   <Button Content="Apply" IsDefault="True" Click="Accept" Style="{StaticResource Form.PrimaryAction}" AutomationProperties.AutomationId="ApplyImageFigure"/>
  </WrapPanel>
 </Grid>
</Window>
