<Window x:Class="LensDocsStudio.Native.ImageFigureWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Image figure" Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="24">
  <TextBlock Text="Image description and caption" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBlock x:Name="ImageReference" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Image location"/>
  <Label Content="_Alternative text" Target="{Binding ElementName=AlternativeText}"/>
  <TextBox x:Name="AlternativeText" Padding="8" MaxLength="4096" AutomationProperties.Name="Image alternative text" AutomationProperties.AutomationId="FigureAlternativeText"/>
  <TextBlock Text="Describe the image for readers who cannot see it." Margin="0,4,0,12" TextWrapping="Wrap"/>
  <Label Content="_Caption" Target="{Binding ElementName=Caption}"/>
  <TextBox x:Name="Caption" Padding="8" MaxLength="4096" AutomationProperties.Name="Image caption" AutomationProperties.AutomationId="FigureCaption"/>
  <TextBlock Text="A caption appears beneath the image. Leave it empty to omit the caption." Margin="0,4,0,12" TextWrapping="Wrap"/>
  <TextBlock x:Name="ValidationMessage" Margin="0,0,0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="FigureValidation"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/>
   <Button Content="Apply" IsDefault="True" Click="Accept" Padding="14,6" AutomationProperties.AutomationId="ApplyImageFigure"/>
  </StackPanel>
 </StackPanel>
</Window>
