<UserControl x:Class="LensDocsStudio.Native.Rendering.PreviewLoadingView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 Focusable="False" IsHitTestVisible="False" Visibility="Collapsed">
 <UserControl.Resources>
  <Style x:Key="PreviewProgressRing" TargetType="ProgressBar">
   <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
   <Setter Property="Tag" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ProgressBar">
      <Viewbox>
       <Grid Width="32" Height="32">
        <Ellipse Margin="3" Stroke="{DynamicResource BorderBrush}" StrokeThickness="3"/>
        <Path Data="M16,3 A13,13 0 0 1 29,16" Stroke="{TemplateBinding Foreground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
         <Path.RenderTransform><RotateTransform x:Name="RingRotation"/></Path.RenderTransform>
        </Path>
       </Grid>
      </Viewbox>
      <ControlTemplate.Triggers>
       <MultiTrigger>
        <MultiTrigger.Conditions>
         <Condition Property="IsVisible" Value="True"/>
         <Condition Property="IsIndeterminate" Value="True"/>
         <Condition Property="Tag"><Condition.Value><sys:Boolean>True</sys:Boolean></Condition.Value></Condition>
        </MultiTrigger.Conditions>
        <MultiTrigger.EnterActions>
         <BeginStoryboard x:Name="Spin"><Storyboard>
          <DoubleAnimation Storyboard.TargetName="RingRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
         </Storyboard></BeginStoryboard>
        </MultiTrigger.EnterActions>
        <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="Spin"/></MultiTrigger.ExitActions>
       </MultiTrigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Border x:Name="Container" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16" Margin="12"
  Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
  <StackPanel x:Name="ContentPanel">
   <ProgressBar x:Name="Ring" Width="32" Height="32" IsIndeterminate="True" Focusable="False" Style="{StaticResource PreviewProgressRing}"
    AutomationProperties.AutomationId="PreviewLoadingIndicator" AutomationProperties.Name="Preview loading" AutomationProperties.ItemStatus="Busy"/>
   <TextBlock x:Name="Status" Margin="0,10,0,0" Foreground="{DynamicResource TextBrush}" Text="Loading preview…"
    TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center"
    AutomationProperties.AutomationId="PreviewLoadingStatus" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </StackPanel>
 </Border>
</UserControl>
