<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:rendering="clr-namespace:LensDocsStudio.Native.Rendering">
  <Style x:Key="DocumentPreviewStyle" TargetType="{x:Type rendering:DocumentPreview}">
   <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
   <Setter Property="SelectionOpacity" Value="0.3"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type rendering:DocumentPreview}">
      <DockPanel Background="{TemplateBinding Background}">
       <Border x:Name="ContinuousGuidance" DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8" Visibility="Collapsed">
        <TextBlock Text="Continuous can be slower for long or complex documents. Choose Pages in Settings for a more responsive preview."
         TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="ContinuousGuidance"/>
       </Border>
       <Border x:Name="PageControls" DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="3">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button Grid.Column="0" Content="‹" Padding="8,2" Margin="0" Command="NavigationCommands.PreviousPage" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
          IsEnabled="{Binding CanGoToPreviousPage, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="Previous page" AutomationProperties.Name="Previous page" AutomationProperties.AutomationId="PreviewPreviousPage"/>
         <Label x:Name="PageNumber" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0" Padding="0" AutomationProperties.AutomationId="PreviewPageNumber"
          Content="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource Self}}">
          <AutomationProperties.Name><MultiBinding StringFormat="Page {0} of {1}"><Binding Path="PageNumber" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="PageCount" RelativeSource="{RelativeSource TemplatedParent}"/></MultiBinding></AutomationProperties.Name>
         </Label>
         <Button Grid.Column="2" Content="›" Padding="8,2" Margin="0" Command="NavigationCommands.NextPage" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
          IsEnabled="{Binding CanGoToNextPage, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="Next page" AutomationProperties.Name="Next page" AutomationProperties.AutomationId="PreviewNextPage"/>
        </Grid>
       </Border>
       <Decorator x:Name="PART_FindToolBarHost" DockPanel.Dock="Top" Visibility="Collapsed"/>
       <Decorator x:Name="PART_ContentHost"/>
      </DockPanel>
      <ControlTemplate.Triggers>
       <Trigger Property="ShowContinuousGuidance" Value="True"><Setter TargetName="ContinuousGuidance" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="ViewingMode" Value="Scroll"><Setter TargetName="PageControls" Property="Visibility" Value="Collapsed"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
</ResourceDictionary>
