<Window x:Class="LensDocsStudio.Native.ContentLibraryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Content library" Width="920" Height="650" MinWidth="680" MinHeight="520" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Your content library" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="Reusable Markdown templates, snippets and export profiles. Import a browser library JSON to merge it with your saved entries." TextWrapping="Wrap" Margin="0,0,0,12"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="Kind" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Library category" AutomationProperties.AutomationId="ContentLibraryCategory">
    <ComboBoxItem Content="Document templates"/><ComboBoxItem Content="Markdown snippets"/><ComboBoxItem Content="Export profiles"/>
   </ComboBox>
   <DockPanel Grid.Column="1" Margin="14,0,0,0"><Label x:Name="FindLabel" Content="_Find" Target="{Binding ElementName=Filter}"/><TextBox x:Name="Filter" TextChanged="FilterChanged" Padding="6" AutomationProperties.Name="Find library entry" AutomationProperties.AutomationId="ContentLibraryFilter"/></DockPanel>
  </Grid>
  <WrapPanel Grid.Row="2" Margin="0,0,0,10">
   <Button x:Name="ImportButton" Content="Import JSON…" Click="Import" Padding="12,6" Margin="0,0,6,6" AutomationProperties.AutomationId="ImportContentLibrary"/>
   <Button x:Name="ExportButton" Content="Export JSON…" Click="Export" Padding="12,6" Margin="0,0,6,6" AutomationProperties.AutomationId="ExportContentLibrary"/>
   <Button x:Name="RenameButton" Content="Rename…" Click="Rename" Padding="12,6" Margin="0,0,6,6" AutomationProperties.AutomationId="RenameContentEntry"/>
   <Button x:Name="ArchiveButton" Content="Archive" Click="ArchiveOrRestore" Padding="12,6" Margin="0,0,6,6" AutomationProperties.AutomationId="ArchiveContentEntry"/>
   <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh" Padding="12,6" Margin="0,0,12,6" AutomationProperties.AutomationId="RefreshContentLibrary"/>
   <CheckBox x:Name="Archived" Content="Show archived" Checked="FilterChanged" Unchecked="FilterChanged" VerticalAlignment="Center" Margin="0,0,0,6" AutomationProperties.AutomationId="ArchivedContentLibrary"/>
  </WrapPanel>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="190"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*" MinWidth="220"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Entries" SelectionChanged="SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Library entries" AutomationProperties.AutomationId="ContentLibraryEntries">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" AutomationProperties.Name="Resize library preview"/>
   <TextBox x:Name="Preview" Grid.Column="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" FontFamily="Consolas" FontSize="13" AutomationProperties.Name="Library entry source preview" AutomationProperties.AutomationId="ContentLibraryPreview"/>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,12,0,12">
   <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" AutomationProperties.Name="Content library operation"/>
   <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ContentLibraryStatus"/></ScrollViewer>
  </StackPanel>
  <WrapPanel Grid.Row="5" HorizontalAlignment="Right">
   <Button x:Name="CancelButton" Content="Cancel operation" IsEnabled="False" Click="CancelOperation" Padding="12,6" Margin="0,0,8,0"/>
   <Button Content="Close" IsCancel="True" Padding="12,6" Margin="0,0,8,0"/>
   <Button x:Name="UseButton" Content="Create document" IsDefault="True" Click="UseSelected" Padding="12,6" AutomationProperties.AutomationId="UseContentEntry"/>
  </WrapPanel>
 </Grid>
</Window>
