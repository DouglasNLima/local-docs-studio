<Window x:Class="LensDocsStudio.Native.SnapshotsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Document snapshots" Width="960" Height="650" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Document snapshots" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <TextBlock Grid.Row="1" Text="Inspect retained source and open a recovered copy in a new, unsaved tab." TextWrapping="Wrap" Margin="0,0,0,14"/>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="SnapshotList" DisplayMemberPath="Label" SelectionChanged="SelectionChanged" AutomationProperties.Name="Retained snapshots" AutomationProperties.AutomationId="SnapshotList">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></Style></ListBox.ItemContainerStyle>
   </ListBox>
   <TextBox x:Name="SourceText" Grid.Column="2" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="13"
      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Snapshot source text" AutomationProperties.AutomationId="SnapshotSource"/>
  </Grid>
  <TextBlock x:Name="SnapshotStatus" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,12" MaxHeight="100" AutomationProperties.AutomationId="SnapshotStatus"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Close" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/>
   <Button x:Name="RestoreButton" Content="Open recovered copy" IsDefault="True" IsEnabled="False" Click="Restore" Padding="14,6" AutomationProperties.AutomationId="RestoreSnapshot"/>
  </StackPanel>
 </Grid>
</Window>
