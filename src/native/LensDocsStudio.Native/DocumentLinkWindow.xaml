<Window x:Class="LensDocsStudio.Native.DocumentLinkWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Insert document link" Width="680" Height="560" MinWidth="480" MinHeight="400"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Link to a workspace document" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBox x:Name="FilterText" Grid.Row="1" Padding="8" Margin="0,0,0,10" TextChanged="FilterChanged" KeyDown="FilterKeyDown"
   AutomationProperties.Name="Filter workspace documents" AutomationProperties.AutomationId="DocumentLinkFilter"/>
  <ListBox x:Name="DocumentsList" Grid.Row="2" SelectionChanged="DocumentSelected" MouseDoubleClick="InsertSelected" KeyDown="ListKeyDown"
   DisplayMemberPath="RelativePath" AutomationProperties.Name="Workspace documents" AutomationProperties.AutomationId="DocumentLinkResults"/>
  <StackPanel Grid.Row="3" Margin="0,12,0,0">
   <TextBlock Text="Link text (optional)" Margin="0,0,0,4"/>
   <TextBox x:Name="LinkLabel" Padding="6" AutomationProperties.Name="Link text" AutomationProperties.AutomationId="DocumentLinkLabel"/>
  </StackPanel>
  <StackPanel Grid.Row="4" Margin="0,10,0,0">
   <TextBlock Text="Section (optional)" Margin="0,0,0,4"/>
   <ComboBox x:Name="SectionList" DisplayMemberPath="Title" SelectedValuePath="Anchor" AutomationProperties.Name="Linked section" AutomationProperties.AutomationId="DocumentLinkSection"/>
  </StackPanel>
  <DockPanel Grid.Row="5" Margin="0,16,0,0">
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="350"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="6,0"/>
    <Button x:Name="InsertButton" Content="Insert link" IsDefault="True" IsEnabled="False" Padding="14,6" Click="InsertSelected" AutomationProperties.AutomationId="InsertDocumentLink"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>
