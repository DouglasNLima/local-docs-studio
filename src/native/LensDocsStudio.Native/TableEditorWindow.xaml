<Window x:Class="LensDocsStudio.Native.TableEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Markdown table" Width="940" Height="640" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" PreviewKeyDown="Shortcut">
 <Window.Resources>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="Padding" Value="6,4"/><Setter Property="FontFamily" Value="Consolas"/></Style>
  <Style x:Key="CellEditor" TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="MaxLength" Value="16384"/></Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock x:Name="Heading" Text="Edit Markdown table" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock x:Name="Summary" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="TableSummary"/>
  </StackPanel>
  <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,8">
   <Button x:Name="AddRow" Content="Add row" Tag="add-row" Click="ChangeStructure" Margin="0,0,6,6" Padding="10,5" AutomationProperties.AutomationId="TableAddRow"/>
   <Button x:Name="RemoveRow" Content="Remove row" Tag="remove-row" Click="ChangeStructure" Margin="0,0,6,6" Padding="10,5" AutomationProperties.AutomationId="TableRemoveRow"/>
   <Button x:Name="RowUp" Content="Row up" Tag="row-up" Click="ChangeStructure" Margin="0,0,6,6" Padding="10,5" AutomationProperties.AutomationId="TableRowUp"/>
   <Button x:Name="RowDown" Content="Row down" Tag="row-down" Click="ChangeStructure" Margin="0,0,6,6" Padding="10,5" AutomationProperties.AutomationId="TableRowDown"/>
   <Button x:Name="AddColumn" Content="Add column" Tag="add-column" Click="ChangeStructure" Margin="0,0,6,6" Padding="10,5" AutomationProperties.AutomationId="TableAddColumn"/>
   <Button x:Name="RemoveColumn" Content="Remove column" Tag="remove-column" Click="ChangeStructure" Margin="0,0,6,6" Padding="10,5" AutomationProperties.AutomationId="TableRemoveColumn"/>
   <Button x:Name="ColumnLeft" Content="Column left" Tag="column-left" Click="ChangeStructure" Margin="0,0,6,6" Padding="10,5" AutomationProperties.AutomationId="TableColumnLeft"/>
   <Button x:Name="ColumnRight" Content="Column right" Tag="column-right" Click="ChangeStructure" Margin="0,0,6,6" Padding="10,5" AutomationProperties.AutomationId="TableColumnRight"/>
   <StackPanel Margin="0,0,0,6">
    <Label Content="Column _alignment" Target="{Binding ElementName=Alignment}" Padding="0,0,0,6"/>
    <ComboBox x:Name="Alignment" Width="110" SelectionChanged="ChangeAlignment" AutomationProperties.Name="Table column alignment" AutomationProperties.AutomationId="TableAlignment">
     <ComboBoxItem Content="Default"/><ComboBoxItem Content="Left"/><ComboBoxItem Content="Centre"/><ComboBoxItem Content="Right"/>
    </ComboBox>
   </StackPanel>
  </WrapPanel>
  <DataGrid x:Name="Cells" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
   EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionUnit="Cell" SelectionMode="Single" HeadersVisibility="All" RowHeaderWidth="64"
   Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
   GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource BorderBrush}" VerticalGridLinesBrush="{DynamicResource BorderBrush}"
   CurrentCellChanged="CellChanged" LoadingRow="LabelRow" AutomationProperties.Name="Markdown table cells" AutomationProperties.AutomationId="TableCells">
   <DataGrid.RowHeaderStyle>
    <Style TargetType="DataGridRowHeader">
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRowHeader">
      <Border Padding="4,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate></Setter.Value></Setter>
    </Style>
   </DataGrid.RowHeaderStyle>
   <DataGrid.CellStyle>
    <Style TargetType="DataGridCell"><Style.Triggers><Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Trigger></Style.Triggers></Style>
   </DataGrid.CellStyle>
  </DataGrid>
  <TextBlock x:Name="Status" Grid.Row="3" Margin="0,10,0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="TableValidation"
   Text="Cells contain editable Markdown. Use F2 to edit, Tab to move, and &lt;br&gt; for line breaks. Apply is one undoable change."/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0" AutomationProperties.AutomationId="CancelTable"/>
   <Button x:Name="ApplyButton" Content="Apply table" Click="Accept" Padding="14,6" ToolTip="Apply the complete table (Ctrl+Enter)" AutomationProperties.AutomationId="ApplyTable"/>
  </StackPanel>
 </Grid>
</Window>
