<Window x:Class="LensDocsStudio.Native.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
 xmlns:workspace="clr-namespace:LensDocsStudio.Native.ViewModels"
 Title="Lens Docs Studio · Native Preview" Width="1440" Height="900" MinWidth="860" MinHeight="540"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 PreviewKeyDown="WindowKeyDown" Closing="WindowClosing" Loaded="WindowLoaded">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
   <Setter Property="IsExpanded" Value="True"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type workspace:WorkspaceEntryViewModel}" ItemsSource="{Binding Children}">
   <TextBlock Text="{Binding Name}" Margin="2,4" ToolTip="{Binding Path}"/>
  </HierarchicalDataTemplate>
 </Window.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="8,3" AutomationProperties.Name="Application menu">
   <MenuItem Header="_File" AutomationProperties.AutomationId="FileMenu">
    <MenuItem Header="_New document" InputGestureText="Ctrl+N" Command="{Binding NewDocumentCommand}"/>
    <MenuItem Header="Create workspace file…" Command="{Binding CreateFileCommand}" AutomationProperties.AutomationId="CreateWorkspaceFile"/>
    <MenuItem Header="Create workspace folder…" Command="{Binding CreateFolderCommand}"/>
    <MenuItem Header="_Open document…" InputGestureText="Ctrl+O" Command="{Binding OpenDocumentCommand}"/>
    <MenuItem Header="Open _folder…" InputGestureText="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}"/>
    <MenuItem Header="Recent _documents" ItemsSource="{Binding RecentDocuments}" AutomationProperties.AutomationId="RecentDocuments">
     <MenuItem.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}"/></DataTemplate></MenuItem.ItemTemplate>
     <MenuItem.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Command" Value="{Binding DataContext.OpenRecentDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Setter Property="CommandParameter" Value="{Binding Path}"/>
     </Style></MenuItem.ItemContainerStyle>
    </MenuItem>
    <MenuItem Header="Recent _workspaces" ItemsSource="{Binding RecentWorkspaces}" AutomationProperties.AutomationId="RecentWorkspaces">
     <MenuItem.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}"/></DataTemplate></MenuItem.ItemTemplate>
     <MenuItem.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Command" Value="{Binding DataContext.OpenRecentWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Setter Property="CommandParameter" Value="{Binding Path}"/>
     </Style></MenuItem.ItemContainerStyle>
    </MenuItem>
    <MenuItem Header="Clear recent lists" Command="{Binding ClearRecentPathsCommand}"/>
    <MenuItem Header="Import Markdown _bundle…" Click="ImportBundle"/>
    <MenuItem Header="Content _library…" Click="ManageContentLibrary" AutomationProperties.AutomationId="ManageContentLibrary"/>
    <MenuItem Header="Save document as template…" Click="SaveLibraryContent" AutomationProperties.AutomationId="SaveDocumentTemplate"/>
    <MenuItem Header="Save selection as snippet…" Tag="snippet" Click="SaveLibraryContent" AutomationProperties.AutomationId="SaveMarkdownSnippet"/>
    <MenuItem Header="_Import DOCX, HTML or PDF…" Click="ImportDocument"/>
    <Separator/>
    <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
    <MenuItem Header="Save _as…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
    <MenuItem Header="_Reload from disk" Command="{Binding ReloadCommand}"/>
    <MenuItem Header="Take snapshot" Command="{Binding TakeSnapshotCommand}" AutomationProperties.AutomationId="TakeSnapshot"/>
    <MenuItem Header="Document snapshots…" Command="{Binding BrowseSnapshotsCommand}" AutomationProperties.AutomationId="BrowseSnapshots"/>
    <MenuItem Header="Workspace images…" Command="{Binding BrowseAssetsCommand}" AutomationProperties.AutomationId="BrowseAssets"/>
    <MenuItem Header="Rename or move document…" InputGestureText="F2" Command="{Binding MoveDocumentCommand}" AutomationProperties.AutomationId="MoveDocument"/>
    <MenuItem Header="Delete document…" Command="{Binding DeleteDocumentCommand}" AutomationProperties.AutomationId="DeleteDocument"/>
    <MenuItem Header="Reveal in File _Explorer" Click="RevealFile"/>
    <Separator/>
    <MenuItem Header="_Close document" InputGestureText="Ctrl+W" Command="{Binding CloseDocumentCommand}" CommandParameter="{Binding ActiveDocument}"/>
    <MenuItem Header="E_xit" Click="Exit"/>
   </MenuItem>
   <MenuItem Header="_Edit" AutomationProperties.AutomationId="EditMenu">
    <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}"/>
    <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}"/>
    <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=Editor}"/>
    <MenuItem Header="Paste _Special" AutomationProperties.AutomationId="PasteSpecialMenu">
     <MenuItem Header="Table" Tag="Table" Click="PasteSpecial" AutomationProperties.AutomationId="PasteTable"/>
     <MenuItem Header="Plain text" InputGestureText="Ctrl+Shift+V" Tag="Text" Click="PasteSpecial" AutomationProperties.AutomationId="PasteText"/>
     <MenuItem Header="Code block" Tag="Code" Click="PasteSpecial"/>
     <MenuItem Header="Quote" Tag="Quote" Click="PasteSpecial"/>
     <MenuItem Header="HTML as Markdown" Tag="Html" Click="PasteSpecial" AutomationProperties.AutomationId="PasteHtml"/>
     <MenuItem Header="List" Tag="List" Click="PasteSpecial"/>
     <MenuItem Header="Checklist" Tag="Checklist" Click="PasteSpecial"/>
     <MenuItem Header="Numbered list" Tag="NumberedList" Click="PasteSpecial"/>
     <MenuItem Header="Mermaid block" Tag="Mermaid" Click="PasteSpecial"/>
    </MenuItem>
    <Separator/>
    <MenuItem Header="_Find" InputGestureText="Ctrl+F" Click="OpenFind"/>
    <MenuItem Header="_Replace" InputGestureText="Ctrl+H" Click="OpenReplace"/>
    <Separator/>
    <MenuItem Header="_Bold" InputGestureText="Ctrl+B" Tag="bold" Click="Format"/>
    <MenuItem Header="_Italic" InputGestureText="Ctrl+I" Tag="italic" Click="Format"/>
    <MenuItem Header="Strikethrough" Tag="strike" Click="Format"/>
    <MenuItem Header="Inline code" Tag="inline-code" Click="Format"/>
    <MenuItem Header="Mermaid suggestions" InputGestureText="Ctrl+Space" Click="ShowCompletion" AutomationProperties.AutomationId="ShowMermaidCompletion"/>
    <MenuItem Header="Copy rendered _text" Click="CopyPreview"/>
    <MenuItem Header="Copy rendered _content" Click="CopyRenderedContent" AutomationProperties.AutomationId="CopyRenderedContent"/>
    <MenuItem Header="Copy _Markdown with images" Click="CopyMarkdownWithImages" AutomationProperties.AutomationId="CopyMarkdownWithImages"/>
   </MenuItem>
   <MenuItem Header="_Insert" AutomationProperties.AutomationId="InsertMenu">
    <MenuItem Header="Heading" Tag="heading" Click="Format"/>
    <MenuItem Header="Link" Tag="link" Click="Format"/>
    <MenuItem Header="Workspace document link…" InputGestureText="Ctrl+Shift+K" Click="InsertDocumentLink" AutomationProperties.AutomationId="DocumentLinkMenu"/>
    <MenuItem Header="Local image…" Click="InsertImage"/>
    <MenuItem Header="Image figure…" Click="EditImageFigure" AutomationProperties.AutomationId="EditImageFigure"/>
    <MenuItem Header="Image from URL…" Click="InsertRemoteImage" AutomationProperties.AutomationId="InsertRemoteImage"/>
    <MenuItem Header="Table" Tag="table" Click="Format"/>
    <MenuItem Header="Task list" Tag="task" Click="Format"/>
    <MenuItem Header="Bullet list" Tag="bullet" Click="Format"/>
    <MenuItem Header="Numbered list" Tag="numbered" Click="Format"/>
    <MenuItem Header="Blockquote" Tag="quote" Click="Format"/>
    <MenuItem Header="Callout" AutomationProperties.AutomationId="CalloutMenu">
     <MenuItem Header="Note" Tag="callout:NOTE" Click="Format" AutomationProperties.AutomationId="InsertNote"/>
     <MenuItem Header="Tip" Tag="callout:TIP" Click="Format"/>
     <MenuItem Header="Important" Tag="callout:IMPORTANT" Click="Format"/>
     <MenuItem Header="Warning" Tag="callout:WARNING" Click="Format"/>
     <MenuItem Header="Caution" Tag="callout:CAUTION" Click="Format"/>
    </MenuItem>
    <MenuItem Header="Code block" Tag="code" Click="Format" AutomationProperties.AutomationId="InsertCode"/>
    <MenuItem Header="Mermaid diagram" Tag="mermaid" Click="Format"/>
    <MenuItem Header="Progress indicator…" Click="InsertProgress" AutomationProperties.AutomationId="InsertProgress"/>
    <MenuItem Header="Document anchor…" Click="InsertAnchor" AutomationProperties.AutomationId="InsertAnchor"/>
   </MenuItem>
   <MenuItem Header="E_xport" AutomationProperties.AutomationId="ExportMenu">
    <MenuItem Header="_Word document…" Tag="DOCX" Click="ExportDocument" AutomationProperties.AutomationId="ExportWord"/>
    <MenuItem Header="_PDF document…" Tag="PDF" Click="ExportDocument"/>
    <MenuItem Header="_HTML document…" Tag="HTML" Click="ExportDocument"/>
    <MenuItem Header="Markdown _bundle…" Click="ExportBundle" AutomationProperties.AutomationId="ExportMarkdownBundle"/>
    <MenuItem Header="Docs _Site…" Click="ExportDocsSite" AutomationProperties.AutomationId="ExportDocsSite"/>
    <MenuItem Header="Export _profiles" AutomationProperties.AutomationId="ExportProfilesMenu">
     <MenuItem x:Name="CurrentExportProfile" Header="Profile: Generic documentation (this session)" IsEnabled="False"/>
     <MenuItem Header="Generic documentation" Tag="generic" Click="ApplyBuiltInProfile" AutomationProperties.AutomationId="GenericExportProfile"/>
     <MenuItem Header="Azure DevOps Wiki Markdown" Tag="devops" Click="ApplyBuiltInProfile" AutomationProperties.AutomationId="DevOpsExportProfile"/>
     <MenuItem Header="GitHub Pages Docs Site" Tag="docs-site" Click="ApplyBuiltInProfile" AutomationProperties.AutomationId="DocsSiteExportProfile"/>
     <Separator/>
     <MenuItem Header="Saved profiles…" Tag="profiles" Click="ManageContentLibrary" AutomationProperties.AutomationId="ManageExportProfiles"/>
     <MenuItem Header="Save current profile…" Click="SaveLibraryProfile" AutomationProperties.AutomationId="SaveExportProfile"/>
    </MenuItem>
    <Separator/>
    <MenuItem Header="Word template _library…" Click="ManageWordTemplates" AutomationProperties.AutomationId="ManageWordTemplates"/>
    <MenuItem Header="Select Word _template…" Click="SelectWordTemplate" AutomationProperties.AutomationId="SelectWordTemplate"/>
    <MenuItem Header="Use _default Word styles" Click="ClearWordTemplate" AutomationProperties.AutomationId="ClearWordTemplate"/>
   </MenuItem>
   <MenuItem Header="_View" AutomationProperties.AutomationId="ViewMenu">
    <MenuItem Header="Document _review…" Click="ReviewDocument" AutomationProperties.AutomationId="ReviewDocument"/>
    <Separator/>
    <MenuItem x:Name="BackMenu" Header="Go _back" InputGestureText="Alt+Left" Click="NavigateBack" IsEnabled="False"/>
    <MenuItem x:Name="ForwardMenu" Header="Go _forward" InputGestureText="Alt+Right" Click="NavigateForward" IsEnabled="False"/>
    <Separator/>
    <MenuItem Header="_Editor" Tag="Editor" Click="ChangeLayout"/>
    <MenuItem Header="_Split" Tag="Split" Click="ChangeLayout"/>
    <MenuItem Header="_Preview" Tag="Preview" Click="ChangeLayout"/>
    <Separator/>
    <MenuItem Header="_Light theme" Tag="Light" Click="ChangeTheme" AutomationProperties.AutomationId="LightTheme"/>
    <MenuItem Header="_Dark theme" Tag="Dark" Click="ChangeTheme" AutomationProperties.AutomationId="DarkTheme"/>
    <MenuItem Header="_Windows theme" Tag="System" Click="ChangeTheme"/>
   </MenuItem>
   <MenuItem Header="_Help" AutomationProperties.AutomationId="HelpMenu"><MenuItem Header="_Updates…" Click="OpenUpdates" AutomationProperties.AutomationId="UpdatesMenu"/><MenuItem Header="_About the native preview" Click="About"/></MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
   <DockPanel>
    <StackPanel Orientation="Horizontal">
     <Border Background="{DynamicResource AccentBrush}" Width="4" Height="25" Margin="0,0,10,0"/>
     <TextBlock Text="Lens Docs Studio" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0"/>
     <Button x:Name="BackButton" Content="←" ToolTip="Back (Alt+Left)" Click="NavigateBack" IsEnabled="False" AutomationProperties.Name="Back" AutomationProperties.AutomationId="NavigateBack"/>
     <Button x:Name="ForwardButton" Content="→" ToolTip="Forward (Alt+Right)" Click="NavigateForward" IsEnabled="False" AutomationProperties.Name="Forward" AutomationProperties.AutomationId="NavigateForward"/>
     <Button Content="Open folder" Command="{Binding OpenFolderCommand}"/>
     <Button Content="Save" Command="{Binding SaveCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" AutomationProperties.AutomationId="SaveDocument"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="Editor" Tag="Editor" Click="ChangeLayout"/>
     <Button Content="Split" Tag="Split" Click="ChangeLayout"/>
     <Button Content="Preview" Tag="Preview" Click="ChangeLayout"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}">
   <StatusBarItem><TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" MaxWidth="600" AutomationProperties.AutomationId="Status" AutomationProperties.LiveSetting="Polite"/></StatusBarItem>
   <Separator/><StatusBarItem><TextBlock Text="{Binding PreviewStatus}" ToolTip="{Binding PreviewStatus}" TextTrimming="CharacterEllipsis" MaxWidth="220" AutomationProperties.AutomationId="PreviewStatus"/></StatusBarItem>
   <Separator/><StatusBarItem><TextBlock x:Name="CaretStatus" Text="UTF-8" AutomationProperties.AutomationId="CaretStatus"/></StatusBarItem>
   <StatusBarItem><Button Content="Cancel operation" Command="{Binding CancelOperationCommand}" IsEnabled="{Binding IsBusy}"/></StatusBarItem>
  </StatusBar>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="150"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0" Background="{DynamicResource PanelBrush}">
    <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" FontSize="11" FontWeight="SemiBold" Margin="14,16,10,4"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding WorkspaceRoot, TargetNullValue='Open a folder to browse documents'}" FontSize="11" Margin="14,0,10,12" TextWrapping="Wrap"/>
    <TreeView x:Name="WorkspaceTree" ItemsSource="{Binding Entries}" BorderThickness="0" Background="Transparent"
      MouseDoubleClick="OpenTreeEntry" KeyDown="TreeKeyDown" AutomationProperties.Name="Workspace files" AutomationProperties.AutomationId="WorkspaceTree"/>
   </DockPanel>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
   <DockPanel Grid.Column="2">
    <TabControl x:Name="DocumentTabs" DockPanel.Dock="Top" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}" Background="{DynamicResource WindowBrush}"
       BorderThickness="0,0,0,1" Padding="0" AutomationProperties.Name="Open documents" SelectionChanged="TabChanged">
     <TabControl.ItemContainerStyle><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Setter Property="ToolTip" Value="{Binding FilePath}"/></Style></TabControl.ItemContainerStyle>
     <TabControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="7,3"/>
      <Button Content="×" Padding="4,0" Margin="5,0,0,0" AutomationProperties.Name="Close document"
       Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
     </StackPanel></DataTemplate></TabControl.ItemTemplate>
     <TabControl.ContentTemplate><DataTemplate><Grid Height="0"/></DataTemplate></TabControl.ContentTemplate>
    </TabControl>
    <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" Padding="8">
     <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="FindContext" Text="Find in editor" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="FindText" Width="210" Padding="5" AutomationProperties.Name="Find text" KeyDown="FindKeyDown"/>
      <TextBox x:Name="ReplaceText" Width="150" Padding="5" Margin="5,0" Visibility="Collapsed" AutomationProperties.Name="Replacement text"/>
      <Button Content="Next" Click="FindNext"/><Button x:Name="ReplaceButton" Content="Replace" Visibility="Collapsed" Click="ReplaceOne"/>
      <Button Content="Close" Click="CloseFind"/>
     </StackPanel>
    </Border>
    <Grid x:Name="ContentGrid">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="*"/><ColumnDefinition x:Name="SplitColumn" Width="5"/><ColumnDefinition x:Name="PreviewColumn" Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
     <avalon:TextEditor x:Name="Editor" Grid.Column="0" ShowLineNumbers="True" FontFamily="Cascadia Code, Consolas" FontSize="14"
        IsReadOnly="{Binding ActiveDocument.IsSaving}"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" Padding="14" BorderThickness="0"
        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" WordWrap="True"
        AllowDrop="True" PreviewDragOver="EditorDragOver" PreviewDrop="EditorDrop"
        GotKeyboardFocus="EditorFocused" AutomationProperties.Name="Markdown editor" AutomationProperties.AutomationId="MarkdownEditor">
      <avalon:TextEditor.ContextMenu>
       <ContextMenu AutomationProperties.Name="Editor actions" Opened="PrepareEditorContext">
        <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" AutomationProperties.AutomationId="EditorContextUndo"/>
        <MenuItem Header="_Redo" Command="ApplicationCommands.Redo"/>
        <Separator/>
        <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" AutomationProperties.AutomationId="EditorContextCut"/>
        <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" AutomationProperties.AutomationId="EditorContextCopy"/>
        <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" AutomationProperties.AutomationId="EditorContextPaste"/>
        <MenuItem Header="Select _all" Command="ApplicationCommands.SelectAll"/>
        <Separator/>
        <MenuItem Header="_Bold" Tag="bold" Click="Format" AutomationProperties.AutomationId="EditorContextBold"/>
        <MenuItem Header="_Italic" Tag="italic" Click="Format"/>
        <MenuItem Header="Document _link…" Click="InsertDocumentLink"/>
       </ContextMenu>
      </avalon:TextEditor.ContextMenu>
     </avalon:TextEditor>
     <GridSplitter x:Name="EditorSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
     <FlowDocumentScrollViewer x:Name="Preview" Grid.Column="2" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
       Background="{DynamicResource WindowBrush}" GotKeyboardFocus="PreviewFocused" PreviewMouseDown="OnPreviewMouseDown"
       AutomationProperties.Name="Document preview" AutomationProperties.AutomationId="DocumentPreview"/>
     <DockPanel Grid.Column="3" Background="{DynamicResource PanelBrush}">
      <TextBlock DockPanel.Dock="Top" Text="ON THIS PAGE" FontSize="11" FontWeight="SemiBold" Margin="12,16,5,10"/>
      <ListBox x:Name="Outline" BorderThickness="0" Background="Transparent" DisplayMemberPath="Title" SelectionChanged="OutlineSelected"
       AutomationProperties.Name="Document outline">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
      </ListBox>
     </DockPanel>
    </Grid>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>

