<Window x:Class="LensDocsStudio.Native.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
 xmlns:workspace="clr-namespace:LensDocsStudio.Native.ViewModels"
 xmlns:rendering="clr-namespace:LensDocsStudio.Native.Rendering"
 xmlns:ui="clr-namespace:LensDocsStudio.Native.Controls"
 Title="Lens Docs Studio · Native Preview" Width="1440" Height="900" MinWidth="860" MinHeight="540"
 Icon="Resources/Brand/application.ico" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 PreviewKeyDown="WindowKeyDown" Closing="WindowClosing" Loaded="WindowLoaded" SizeChanged="DesktopWindowResized">
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="Resources/CommandIcons.xaml"/>
   <ResourceDictionary Source="Resources/DesktopStyles.xaml"/>
   <ResourceDictionary Source="Rendering/DocumentPreview.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <ui:HeadingIndentConverter x:Key="HeadingIndent"/>

  <Style TargetType="TreeViewItem" BasedOn="{StaticResource Desktop.WorkspaceItem}">
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
   <Setter Property="AutomationProperties.HelpText" Value="{Binding FileTypeDescription}"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type workspace:WorkspaceEntryViewModel}" ItemsSource="{Binding Children}">
   <DockPanel ToolTip="{Binding Path}" Margin="2,4">
    <ui:CommandIcon Kind="{Binding IconKind}" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0"/>
    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding DocumentIndicator}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
   </DockPanel>
  </HierarchicalDataTemplate>
   </ResourceDictionary>
 </Window.Resources>
 <DockPanel>
  <ui:AdaptiveHeaderPanel x:Name="ApplicationHeader" DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" AutomationProperties.AutomationId="AdaptiveApplicationHeader">
  <Menu x:Name="ApplicationMenu" DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="8,3" AutomationProperties.Name="Application menu">
   <MenuItem Header="_File" AutomationProperties.AutomationId="FileMenu">
    <MenuItem Header="_New document" InputGestureText="Ctrl+N" Command="{Binding NewDocumentCommand}"/>
    <MenuItem Header="Create from template…" Click="BrowseContentCatalogue" AutomationProperties.AutomationId="BrowseContentCatalogue"/>
    <MenuItem Header="Create workspace file…" Command="{Binding CreateFileCommand}" AutomationProperties.AutomationId="CreateWorkspaceFile"/>
    <MenuItem Header="Create workspace folder…" Command="{Binding CreateFolderCommand}"/>
    <MenuItem Header="_Open document…" InputGestureText="Ctrl+O" Command="{Binding OpenDocumentCommand}"/>
    <MenuItem Header="Open _folder…" InputGestureText="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}"/>
    <MenuItem Header="Close _workspace" Command="{Binding CloseWorkspaceCommand}" AutomationProperties.AutomationId="CloseWorkspaceMenu"><MenuItem.Icon><ui:CommandIcon Kind="CloseWorkspace"/></MenuItem.Icon></MenuItem>
    <MenuItem Header="Recent _documents" ItemsSource="{Binding RecentDocuments}" AutomationProperties.AutomationId="RecentDocuments">
     <MenuItem.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}"/></DataTemplate></MenuItem.ItemTemplate>
     <MenuItem.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Command" Value="{Binding DataContext.OpenRecentDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Setter Property="CommandParameter" Value="{Binding Path}"/>
     </Style></MenuItem.ItemContainerStyle>
    </MenuItem>
    <MenuItem Header="Recent _workspaces" ItemsSource="{Binding RecentWorkspaces}" AutomationProperties.AutomationId="RecentWorkspaces">
     <MenuItem.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}"/></DataTemplate></MenuItem.ItemTemplate>
     <MenuItem.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Command" Value="{Binding DataContext.OpenRecentWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Setter Property="CommandParameter" Value="{Binding Path}"/>
     </Style></MenuItem.ItemContainerStyle>
    </MenuItem>
    <MenuItem Header="Clear recent lists" Command="{Binding ClearRecentPathsCommand}"/>
    <MenuItem Header="Import Markdown _bundle…" Click="ImportBundle" AutomationProperties.AutomationId="ImportMarkdownBundle"/>
    <MenuItem Header="Content _library…" Click="ManageContentLibrary" AutomationProperties.AutomationId="ManageContentLibrary"/>
    <MenuItem Header="Save document as template…" Click="SaveLibraryContent" AutomationProperties.AutomationId="SaveDocumentTemplate"/>
    <MenuItem Header="Save selection as snippet…" Tag="snippet" Click="SaveLibraryContent" AutomationProperties.AutomationId="SaveMarkdownSnippet"/>
    <MenuItem Header="_Import DOCX, HTML or PDF…" Click="ImportDocument" AutomationProperties.AutomationId="ImportDocument"/>
    <Separator/>
    <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
    <MenuItem Header="Save _as…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
    <MenuItem Header="_Reload from disk" Command="{Binding ReloadCommand}"/>
    <MenuItem Header="Take snapshot" Command="{Binding TakeSnapshotCommand}" AutomationProperties.AutomationId="TakeSnapshot"/>
    <MenuItem Header="Document snapshots…" Command="{Binding BrowseSnapshotsCommand}" AutomationProperties.AutomationId="BrowseSnapshots"/>
    <MenuItem Header="Workspace images…" Command="{Binding BrowseAssetsCommand}" AutomationProperties.AutomationId="BrowseAssets"/>
    <MenuItem Header="Rename or move document…" InputGestureText="F2" Command="{Binding MoveDocumentCommand}" AutomationProperties.AutomationId="MoveDocument"/>
    <MenuItem Header="Rename or move selected folder…" Command="{Binding MoveFolderCommand}" CommandParameter="{Binding SelectedItem, ElementName=WorkspaceTree}" AutomationProperties.AutomationId="MoveFolder"/>
    <MenuItem Header="Delete document…" Command="{Binding DeleteDocumentCommand}" AutomationProperties.AutomationId="DeleteDocument"/>
    <MenuItem Header="Reveal in File _Explorer" Click="RevealFile"/>
    <Separator/>
    <MenuItem Header="_Close document" InputGestureText="Ctrl+W" Command="{Binding CloseDocumentCommand}" CommandParameter="{Binding ActiveDocument}"/>
    <MenuItem Header="E_xit" Click="Exit"/>
   </MenuItem>
   <MenuItem Header="_Edit" AutomationProperties.AutomationId="EditMenu">
    <MenuItem Header="Command _Palette…" InputGestureText="Ctrl+Shift+P" Click="OpenCommandPalette"/>
    <MenuItem Header="_Quick Open…" InputGestureText="Ctrl+P" Click="OpenQuickOpen"/>
    <Separator/>
    <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}"/>
    <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}"/>
    <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=Editor}"/>
    <MenuItem Header="Paste _Special" AutomationProperties.AutomationId="PasteSpecialMenu">
     <MenuItem Header="Table" Tag="Table" Click="PasteSpecial" AutomationProperties.AutomationId="PasteTable"/>
     <MenuItem Header="Plain text" InputGestureText="Ctrl+Shift+V" Tag="Text" Click="PasteSpecial" AutomationProperties.AutomationId="PasteText"/>
     <MenuItem Header="Code block" Tag="Code" Click="PasteSpecial"/>
     <MenuItem Header="Quote" Tag="Quote" Click="PasteSpecial"/>
     <MenuItem Header="HTML as Markdown" Tag="Html" Click="PasteSpecial" AutomationProperties.AutomationId="PasteHtml"/>
     <MenuItem Header="List" Tag="List" Click="PasteSpecial"/>
     <MenuItem Header="Checklist" Tag="Checklist" Click="PasteSpecial"/>
     <MenuItem Header="Numbered list" Tag="NumberedList" Click="PasteSpecial"/>
     <MenuItem Header="Mermaid block" Tag="Mermaid" Click="PasteSpecial"/>
    </MenuItem>
    <Separator/>
    <MenuItem Header="_Find" InputGestureText="Ctrl+F" Click="OpenFind"/>
    <MenuItem Header="_Replace" InputGestureText="Ctrl+H" Click="OpenReplace"/>
    <Separator/>
    <MenuItem Header="_Bold" InputGestureText="Ctrl+B" Tag="bold" Click="Format"/>
    <MenuItem Header="_Italic" InputGestureText="Ctrl+I" Tag="italic" Click="Format"/>
    <MenuItem Header="Strikethrough" Tag="strike" Click="Format"/>
    <MenuItem Header="Inline code" Tag="inline-code" Click="Format"/>
    <MenuItem Header="Mermaid suggestions" InputGestureText="Ctrl+Space" Click="ShowCompletion" AutomationProperties.AutomationId="ShowMermaidCompletion"/>
    <MenuItem Header="Copy rendered _text" Click="CopyPreview" AutomationProperties.AutomationId="CopyRenderedText"/>
    <MenuItem Header="Copy rendered _content" Click="CopyRenderedContent" AutomationProperties.AutomationId="CopyRenderedContent"/>
    <MenuItem Header="Copy _Markdown with images" Click="CopyMarkdownWithImages" AutomationProperties.AutomationId="CopyMarkdownWithImages"/>
    <Separator/>
    <MenuItem Header="_Settings…" InputGestureText="Ctrl+," Click="OpenSettings" AutomationProperties.AutomationId="OpenSettings"/>
   </MenuItem>
   <MenuItem Header="_Insert" AutomationProperties.AutomationId="InsertMenu">
    <MenuItem Header="Flowchart visually…" Click="InsertFlowchart" AutomationProperties.AutomationId="InsertFlowchart"/>
    <MenuItem Header="Sequence diagram visually…" Click="InsertSequence" AutomationProperties.AutomationId="InsertSequence"/>
    <MenuItem Header="State diagram visually…" Click="InsertState" AutomationProperties.AutomationId="InsertState"/>
    <MenuItem Header="ER diagram visually…" Click="InsertEr" AutomationProperties.AutomationId="InsertEr"/>
    <MenuItem Header="Class diagram visually…" Click="InsertClass" AutomationProperties.AutomationId="InsertClass"/>
    <MenuItem Header="Gantt chart visually…" Click="InsertGantt" AutomationProperties.AutomationId="InsertGantt"/>
    <MenuItem Header="Mind map visually…" Click="InsertMindmap" AutomationProperties.AutomationId="InsertMindmap"/>
    <MenuItem Header="Pie chart visually…" Click="InsertPie" AutomationProperties.AutomationId="InsertPie"/>
    <MenuItem Header="Quadrant chart visually…" Click="InsertQuadrant" AutomationProperties.AutomationId="InsertQuadrant"/>
    <MenuItem Header="Built-in snippet…" Tag="snippet" Click="BrowseContentCatalogue" AutomationProperties.AutomationId="BrowseSnippetCatalogue"/>
    <MenuItem Header="Heading" Tag="heading" Click="Format"/>
    <MenuItem Header="Link" Tag="link" Click="Format"/>
    <MenuItem Header="Workspace document link…" InputGestureText="Ctrl+Shift+K" Click="InsertDocumentLink" AutomationProperties.AutomationId="DocumentLinkMenu"/>
    <MenuItem Header="Local image…" Click="InsertImage"/>
    <MenuItem Header="Image figure…" Click="EditImageFigure" AutomationProperties.AutomationId="EditImageFigure"/>
    <MenuItem Header="Image from URL…" Click="InsertRemoteImage" AutomationProperties.AutomationId="InsertRemoteImage"/>
    <MenuItem Header="Table…" Click="EditTable" AutomationProperties.AutomationId="EditTable"/>
    <MenuItem Header="Task list" Tag="task" Click="Format"/>
    <MenuItem Header="Bullet list" Tag="bullet" Click="Format"/>
    <MenuItem Header="Numbered list" Tag="numbered" Click="Format"/>
    <MenuItem Header="Blockquote" Tag="quote" Click="Format"/>
    <MenuItem Header="Horizontal rule" Tag="rule" Click="Format" AutomationProperties.AutomationId="InsertHorizontalRule"/>
    <MenuItem Header="Status badge" AutomationProperties.AutomationId="StatusBadgeMenu">
     <MenuItem Header="Draft…" Tag="draft" Click="InsertInlineLabel" AutomationProperties.AutomationId="InsertDraftBadge"/>
     <MenuItem Header="Ready…" Tag="ready" Click="InsertInlineLabel" AutomationProperties.AutomationId="InsertReadyBadge"/>
     <MenuItem Header="Blocked…" Tag="blocked" Click="InsertInlineLabel" AutomationProperties.AutomationId="InsertBlockedBadge"/>
     <MenuItem Header="Deprecated…" Tag="deprecated" Click="InsertInlineLabel" AutomationProperties.AutomationId="InsertDeprecatedBadge"/>
     <MenuItem Header="Beta…" Tag="beta" Click="InsertInlineLabel" AutomationProperties.AutomationId="InsertBetaBadge"/>
     <MenuItem Header="In review…" Tag="review" Click="InsertInlineLabel" AutomationProperties.AutomationId="InsertReviewBadge"/>
    </MenuItem>
    <MenuItem Header="Keyboard shortcut…" Tag="shortcut" Click="InsertInlineLabel" AutomationProperties.AutomationId="InsertKeyboardShortcut"/>
    <MenuItem Header="Callout" AutomationProperties.AutomationId="CalloutMenu">
     <MenuItem Header="Note" Tag="callout:NOTE" Click="Format" AutomationProperties.AutomationId="InsertNote"/>
     <MenuItem Header="Tip" Tag="callout:TIP" Click="Format"/>
     <MenuItem Header="Important" Tag="callout:IMPORTANT" Click="Format"/>
     <MenuItem Header="Warning" Tag="callout:WARNING" Click="Format"/>
     <MenuItem Header="Caution" Tag="callout:CAUTION" Click="Format"/>
    </MenuItem>
    <MenuItem Header="Code block" Tag="code" Click="Format" AutomationProperties.AutomationId="InsertCode"/>
    <MenuItem Header="Mermaid diagram" Tag="mermaid" Click="Format"/>
    <MenuItem Header="Progress indicator…" Click="InsertProgress" AutomationProperties.AutomationId="InsertProgress"/>
    <MenuItem Header="Details section…" Click="EditDetails" AutomationProperties.AutomationId="EditDetails"/>
    <MenuItem Header="Document anchor…" Click="InsertAnchor" AutomationProperties.AutomationId="InsertAnchor"/>
   </MenuItem>
   <MenuItem Header="E_xport" AutomationProperties.AutomationId="ExportMenu">
    <MenuItem x:Name="RecentExportsMenu" Header="_Recent exports" AutomationProperties.AutomationId="RecentExportsMenu"><MenuItem Header="No exports this session" IsEnabled="False"/></MenuItem>
    <Separator/>
    <MenuItem Header="_Word document…" Tag="DOCX" Click="ExportDocument" AutomationProperties.AutomationId="ExportWord"/>
    <MenuItem Header="_PDF document…" Tag="PDF" Click="ExportDocument" AutomationProperties.AutomationId="ExportPdf"/>
    <MenuItem Header="_HTML document…" Tag="HTML" Click="ExportDocument" AutomationProperties.AutomationId="ExportHtml"/>
    <MenuItem Header="Markdown _bundle…" Click="ExportBundle" AutomationProperties.AutomationId="ExportMarkdownBundle"/>
    <MenuItem x:Name="ArtifactReviewPackMenu" Header="Artefact _review pack…" Click="ExportArtifactReviewPack" IsEnabled="False" AutomationProperties.AutomationId="ExportArtifactReviewPack"/>
    <MenuItem Header="Docs _Site…" Click="ExportDocsSite" AutomationProperties.AutomationId="ExportDocsSite"/>
    <MenuItem Header="Export _profiles" AutomationProperties.AutomationId="ExportProfilesMenu">
     <MenuItem x:Name="CurrentExportProfile" Header="Profile: Generic documentation (this session)" IsEnabled="False"/>
     <MenuItem Header="Generic documentation" Tag="generic" Click="ApplyBuiltInProfile" AutomationProperties.AutomationId="GenericExportProfile"/>
     <MenuItem Header="Azure DevOps Wiki Markdown" Tag="devops" Click="ApplyBuiltInProfile" AutomationProperties.AutomationId="DevOpsExportProfile"/>
     <MenuItem Header="GitHub Pages Docs Site" Tag="docs-site" Click="ApplyBuiltInProfile" AutomationProperties.AutomationId="DocsSiteExportProfile"/>
     <Separator/>
     <MenuItem Header="Saved profiles…" Tag="profiles" Click="ManageContentLibrary" AutomationProperties.AutomationId="ManageExportProfiles"/>
     <MenuItem Header="Save current profile…" Click="SaveLibraryProfile" AutomationProperties.AutomationId="SaveExportProfile"/>
    </MenuItem>
    <Separator/>
    <MenuItem Header="Word template _library…" Click="ManageWordTemplates" AutomationProperties.AutomationId="ManageWordTemplates"/>
    <MenuItem Header="Select Word _template…" Click="SelectWordTemplate" AutomationProperties.AutomationId="SelectWordTemplate"/>
    <MenuItem Header="Use _default Word styles" Click="ClearWordTemplate" AutomationProperties.AutomationId="ClearWordTemplate"/>
   </MenuItem>
   <MenuItem Header="_View" AutomationProperties.AutomationId="ViewMenu">
    <MenuItem Header="Toggle _workspace" InputGestureText="Ctrl+Alt+B" Click="ToggleSidebar"/>
    <MenuItem Header="Toggle _outline" InputGestureText="Ctrl+Alt+O" Click="ToggleOutline"/>
    <MenuItem Header="_Full Screen" InputGestureText="F11" Click="ToggleFullScreen"/>
    <MenuItem Header="_Focus Mode" InputGestureText="Ctrl+Alt+Z" Click="ToggleFocusMode"/>
    <Separator/>
    <MenuItem Header="Workspace _map…" Click="OpenWorkspaceMap" AutomationProperties.AutomationId="OpenWorkspaceMap"/>
    <MenuItem Header="Document _review…" Click="ReviewDocument" AutomationProperties.AutomationId="ReviewDocument"/>
    <MenuItem x:Name="ArtifactReaderMenu" Header="Artefact _bundle…" Click="OpenArtifactReader" IsEnabled="False" AutomationProperties.AutomationId="OpenArtifactReader"/>
    <Separator/>
    <MenuItem x:Name="BackMenu" Header="Go _back" InputGestureText="Alt+Left" Click="NavigateBack" IsEnabled="False"/>
    <MenuItem x:Name="ForwardMenu" Header="Go _forward" InputGestureText="Alt+Right" Click="NavigateForward" IsEnabled="False"/>
    <Separator/>
    <MenuItem Header="_Editor" Tag="Editor" Click="ChangeLayout" AutomationProperties.AutomationId="LayoutEditor"/>
    <MenuItem Header="_Split" Tag="Split" Click="ChangeLayout" AutomationProperties.AutomationId="LayoutSplit"/>
    <MenuItem Header="_Preview" Tag="Preview" Click="ChangeLayout" AutomationProperties.AutomationId="LayoutPreview"/>
    <Separator/>
    <MenuItem Header="_Light theme" Tag="Light" Click="ChangeTheme" AutomationProperties.AutomationId="LightTheme"/>
    <MenuItem Header="_Dark theme" Tag="Dark" Click="ChangeTheme" AutomationProperties.AutomationId="DarkTheme"/>
    <MenuItem Header="_Windows theme" Tag="System" Click="ChangeTheme" AutomationProperties.AutomationId="WindowsTheme"/>
    <MenuItem x:Name="DiagramThemeMenu" Header="_Diagram theme" AutomationProperties.AutomationId="DiagramThemeMenu">
     <MenuItem Header="_Auto" Tag="Auto" IsCheckable="True" Click="ChangeDiagramTheme" AutomationProperties.AutomationId="DiagramThemeAuto"/>
     <MenuItem Header="_Lens" Tag="Lens" IsCheckable="True" Click="ChangeDiagramTheme" AutomationProperties.AutomationId="DiagramThemeLens"/>
     <MenuItem Header="_Default" Tag="Default" IsCheckable="True" Click="ChangeDiagramTheme" AutomationProperties.AutomationId="DiagramThemeDefault"/>
     <MenuItem Header="_Neutral" Tag="Neutral" IsCheckable="True" Click="ChangeDiagramTheme" AutomationProperties.AutomationId="DiagramThemeNeutral"/>
     <MenuItem Header="_Forest" Tag="Forest" IsCheckable="True" Click="ChangeDiagramTheme" AutomationProperties.AutomationId="DiagramThemeForest"/>
     <MenuItem Header="Dar_k" Tag="Dark" IsCheckable="True" Click="ChangeDiagramTheme" AutomationProperties.AutomationId="DiagramThemeDark"/>
    </MenuItem>
   </MenuItem>
   <MenuItem Header="_Help" AutomationProperties.AutomationId="HelpMenu"><MenuItem Header="Native _guide…" InputGestureText="F1" Click="OpenHelp" AutomationProperties.AutomationId="OpenHelp"/><Separator/><MenuItem Header="_Updates…" Click="OpenUpdates" AutomationProperties.AutomationId="UpdatesMenu"/><MenuItem Header="_About the native preview" Click="About" AutomationProperties.AutomationId="AboutNativePreview"/></MenuItem>
  </Menu>
  <Border x:Name="PrimaryToolbar" DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
   <DockPanel Background="{DynamicResource PanelBrush}">
    <ToolBar x:Name="ApplicationToolbar" Style="{StaticResource Desktop.Toolbar}" AutomationProperties.Name="Application commands">
     <Button Click="ToggleSidebar" ToolTip="Toggle workspace (Ctrl+Alt+B)" AutomationProperties.Name="Toggle workspace (Ctrl+Alt+B)" AutomationProperties.AutomationId="ToggleSidebar"><ui:CommandIcon Kind="Sidebar"/></Button>
     <Button Command="{Binding NewDocumentCommand}" ToolTip="New document (Ctrl+N)" AutomationProperties.Name="New document (Ctrl+N)"><ui:CommandIcon Kind="New"/></Button>
     <Button Command="{Binding OpenDocumentCommand}" ToolTip="Open document (Ctrl+O)" AutomationProperties.Name="Open document (Ctrl+O)"><ui:CommandIcon Kind="Open"/></Button>
     <Button Command="{Binding OpenFolderCommand}" ToolTip="Open workspace (Ctrl+Shift+O)" AutomationProperties.Name="Open workspace (Ctrl+Shift+O)"><ui:CommandIcon Kind="Folder"/></Button>
     <Button Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save (Ctrl+S)" AutomationProperties.AutomationId="SaveDocument"><ui:CommandIcon Kind="Save"/></Button>
<Separator/>
     <Button x:Name="BackButton" Click="NavigateBack" IsEnabled="False" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back (Alt+Left)" AutomationProperties.AutomationId="NavigateBack"><ui:CommandIcon Kind="Back"/></Button>
     <Button x:Name="ForwardButton" Click="NavigateForward" IsEnabled="False" ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward (Alt+Right)" AutomationProperties.AutomationId="NavigateForward"><ui:CommandIcon Kind="Forward"/></Button>
     <Button Click="OpenQuickOpen" ToolTip="Quick Open (Ctrl+P)" AutomationProperties.Name="Quick Open (Ctrl+P)" AutomationProperties.AutomationId="QuickOpen"><ui:CommandIcon Kind="Search"/></Button>
     <Button Click="OpenCommandPalette" ToolTip="Command Palette (Ctrl+Shift+P)" AutomationProperties.Name="Command Palette (Ctrl+Shift+P)" AutomationProperties.AutomationId="CommandPalette"><ui:CommandIcon Kind="Palette"/></Button>
<Separator/>
     <Button Tag="Editor" Click="ChangeLayout" ToolTip="Editor layout" AutomationProperties.Name="Editor layout" AutomationProperties.AutomationId="LayoutEditor"><ui:CommandIcon Kind="Editor"/></Button>
     <Button Tag="Split" Click="ChangeLayout" ToolTip="Split layout" AutomationProperties.Name="Split layout" AutomationProperties.AutomationId="LayoutSplit"><ui:CommandIcon Kind="Split"/></Button>
     <Button Tag="Preview" Click="ChangeLayout" ToolTip="Preview layout" AutomationProperties.Name="Preview layout" AutomationProperties.AutomationId="LayoutPreview"><ui:CommandIcon Kind="Preview"/></Button>
<Separator/>
     <Button Click="ToggleOutline" ToolTip="Toggle outline (Ctrl+Alt+O)" AutomationProperties.Name="Toggle outline (Ctrl+Alt+O)" AutomationProperties.AutomationId="ToggleOutline"><ui:CommandIcon Kind="Outline"/></Button>
     <Button Click="OpenThemeMenu" ToolTip="Change theme" AutomationProperties.Name="Change theme" AutomationProperties.AutomationId="QuickTheme"><ui:CommandIcon Kind="Theme"/></Button>
     <Button Click="ToggleFocusMode" ToolTip="Focus Mode (Ctrl+Alt+Z)" AutomationProperties.Name="Focus Mode (Ctrl+Alt+Z)" AutomationProperties.AutomationId="FocusMode"><ui:CommandIcon Kind="Focus"/></Button>
     <Button Click="ToggleFullScreen" ToolTip="Full Screen (F11)" AutomationProperties.Name="Full Screen (F11)" AutomationProperties.AutomationId="FullScreen"><ui:CommandIcon Kind="FullScreen"/></Button>
     <Button Click="OpenSettings" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings (Ctrl+,)" AutomationProperties.AutomationId="ToolbarSettings"><ui:CommandIcon Kind="Settings"/></Button>
    </ToolBar>
   </DockPanel>
  </Border>
  </ui:AdaptiveHeaderPanel>
  <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}">
   <StatusBar.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></StatusBar.ItemsPanel>
   <StatusBarItem HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.AutomationId="Status" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" AutomationProperties.AutomationId="ExportCompletionActions">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding CompletedExport}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Button Content="Open file" Click="OpenCompletedExport" ToolTip="Open the successfully exported file in its registered Windows application" AutomationProperties.HelpText="{Binding CompletedExport.Path}" AutomationProperties.AutomationId="OpenExportedFile" Margin="0,0,4,0" Padding="8,3"/>
      <Button Content="Show in folder" Click="RevealCompletedExport" ToolTip="Select the exported file in File Explorer" AutomationProperties.HelpText="{Binding CompletedExport.Path}" AutomationProperties.AutomationId="RevealExportedFile" Margin="0,0,4,0" Padding="8,3"/>
      <Button Command="{Binding DismissExportCommand}" ToolTip="Dismiss export actions" AutomationProperties.Name="Dismiss export actions" Padding="5,3" Margin="0,0,8,0"><ui:CommandIcon Kind="Close" Width="12" Height="12"/></Button>
     </StackPanel>
     <TextBlock x:Name="PreviewStatusLabel" Grid.Column="2" Text="{Binding PreviewStatus}" ToolTip="{Binding PreviewStatus}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="180" AutomationProperties.AutomationId="PreviewStatus"/>
     <TextBlock Grid.Column="3" x:Name="CaretStatus" Text="UTF-8" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.AutomationId="CaretStatus"/>
     <!-- Reserve the cancellation control's measured size so operations cannot repaginate the reader. -->
     <Button Grid.Column="4" Content="Cancel operation" Command="{Binding CancelOperationCommand}" IsEnabled="{Binding IsBusy}" AutomationProperties.AutomationId="CancelOperation">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers>
       <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers></Style></Button.Style>
     </Button>
    </Grid>
   </StatusBarItem>
  </StatusBar>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="230"/><ColumnDefinition x:Name="SidebarSplitterColumn" Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource PanelBrush}">
    <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" FontSize="11" FontWeight="SemiBold" Margin="14,16,10,4"/>
    <DockPanel DockPanel.Dock="Top" Margin="10,0,8,8">
     <Button DockPanel.Dock="Right" Command="{Binding CloseWorkspaceCommand}" Width="26" Height="26" MinHeight="26" Padding="4" ToolTip="Close workspace · keep open documents and unsaved changes" AutomationProperties.Name="Close workspace" AutomationProperties.AutomationId="CloseWorkspace">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Desktop.CommandButton}"><Style.Triggers><DataTrigger Binding="{Binding WorkspaceRoot}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
      <ui:CommandIcon Kind="CloseWorkspace" Width="16" Height="16"/>
     </Button>
     <TextBlock Text="{Binding WorkspaceName}" ToolTip="{Binding WorkspaceRoot}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <ToolBar x:Name="WorkspaceToolbar" DockPanel.Dock="Top" Style="{StaticResource Desktop.Toolbar}" AutomationProperties.Name="Workspace commands">
     <Button Command="{Binding ExpandWorkspaceCommand}" ToolTip="Expand all folders" AutomationProperties.Name="Expand all folders"><ui:CommandIcon Kind="Expand"/></Button>
     <Button Command="{Binding CollapseWorkspaceCommand}" ToolTip="Collapse all folders" AutomationProperties.Name="Collapse all folders"><ui:CommandIcon Kind="Collapse"/></Button>
     <Button Command="{Binding RefreshWorkspaceCommand}" ToolTip="Refresh workspace" AutomationProperties.Name="Refresh workspace"><ui:CommandIcon Kind="Refresh"/></Button>
     <Button Click="OpenWorkspaceRootContext" ToolTip="Workspace actions" AutomationProperties.Name="Workspace actions"><ui:CommandIcon Kind="Folder"/></Button>
    </ToolBar>
    <Grid DockPanel.Dock="Top" Margin="10,4,10,10">
     <TextBox x:Name="WorkspaceFilterField" Text="{Binding WorkspaceFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6" ToolTip="Filter workspace filenames or relative paths"
      AutomationProperties.Name="Filter workspace files" AutomationProperties.AutomationId="WorkspaceFilter"/>
     <TextBlock Text="Filter files…" DataContext="{Binding ElementName=WorkspaceFilterField}" Style="{StaticResource Desktop.FilterHint}"/>
    </Grid>
    <Grid><TreeView x:Name="WorkspaceTree" ItemsSource="{Binding Entries}" BorderThickness="0" Background="Transparent"
      MouseDoubleClick="OpenTreeEntry" KeyDown="TreeKeyDown" PreviewMouseRightButtonDown="WorkspaceRightClicked" AutomationProperties.Name="Workspace files" AutomationProperties.AutomationId="WorkspaceTree"/>
     <StackPanel Margin="14,10" VerticalAlignment="Top">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding WorkspaceEmptyMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding WorkspaceEmptyMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.AutomationId="WorkspaceEmptyState"/>
      <Button Content="Open workspace…" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="8,5">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding WorkspaceRoot}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <Button Content="Clear filter" Command="{Binding ClearWorkspaceFilterCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="8,5">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding WorkspaceFilter}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
     </StackPanel>
    </Grid>
   </DockPanel>
   <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" DragCompleted="PanelResized" AutomationProperties.Name="Resize workspace"/>
   <DockPanel Grid.Column="2">
    <TabControl x:Name="DocumentTabs" Style="{StaticResource Desktop.DocumentTabs}" DockPanel.Dock="Top" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}" Background="{DynamicResource WindowBrush}"
       BorderThickness="0,0,0,1" Padding="0" AutomationProperties.Name="Open documents" SelectionChanged="TabChanged" SizeChanged="TabStripResized">
     <TabControl.ItemContainerStyle><Style TargetType="TabItem" BasedOn="{StaticResource Desktop.DocumentTab}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Setter Property="ToolTip" Value="{Binding FilePath}"/>
      <EventSetter Event="PreviewMouseDown" Handler="TabMouseDown"/>
      <EventSetter Event="PreviewKeyDown" Handler="TabContextKeyDown"/>
     </Style></TabControl.ItemContainerStyle>
     <TabControl.ItemTemplate><DataTemplate><DockPanel>
      <Button DockPanel.Dock="Right" Padding="3" Margin="2,0" MinHeight="24" ToolTip="Close document" AutomationProperties.Name="Close document"
       Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Desktop.CommandButton}"><Style.Triggers>
        <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers></Style></Button.Style>
       <ui:CommandIcon Kind="Close" Width="14" Height="14"/>
      </Button>
      <ui:CommandIcon Kind="Pin" DockPanel.Dock="Left" Width="14" Height="14" Margin="2,0,2,0">
       <ui:CommandIcon.Style><Style TargetType="ui:CommandIcon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
        <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
       </Style.Triggers></Style></ui:CommandIcon.Style>
      </ui:CommandIcon>
      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center" Margin="5,3"/>
     </DockPanel></DataTemplate></TabControl.ItemTemplate>
     <TabControl.ContentTemplate><DataTemplate><Grid Height="0"/></DataTemplate></TabControl.ContentTemplate>
    </TabControl>
    <TextBlock DockPanel.Dock="Top" Text="{Binding ActiveDocument.Location}" ToolTip="{Binding ActiveDocument.FilePath}" Margin="12,4" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Document location" AutomationProperties.AutomationId="DocumentLocation"/>
    <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" Padding="8" FocusManager.IsFocusScope="True">
     <WrapPanel>
      <TextBlock x:Name="FindContext" Text="Find in editor" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="FindText" Width="210" Padding="5" AutomationProperties.Name="Find text" KeyDown="FindKeyDown"/>
      <TextBox x:Name="ReplaceText" Width="150" Padding="5" Margin="5,0" Visibility="Collapsed" AutomationProperties.Name="Replacement text"/>
      <Button Content="Next" Click="FindNext" AutomationProperties.AutomationId="FindNext"/><Button x:Name="ReplaceButton" Content="Replace" Visibility="Collapsed" Click="ReplaceOne" AutomationProperties.AutomationId="ReplaceOne"/>
      <Button Content="Close" Click="CloseFind" AutomationProperties.AutomationId="CloseFind"/>
     </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12" AutomationProperties.AutomationId="QuickStart">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
      <DataTrigger Binding="{Binding ActiveDocument.IsEmptyDraft}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     </Style.Triggers></Style></Border.Style>
     <StackPanel>
      <TextBlock Text="Start with a workspace or document, or type below to create Markdown." TextWrapping="Wrap"/>
      <TextBlock Text="Ctrl+S saves your work. Choose Split or Preview to read it; Insert adds local images and Export creates Word or PDF files. Help includes the guide and installed version." TextWrapping="Wrap" FontSize="12" Margin="0,4,0,6"/>
      <WrapPanel><Button Content="Open workspace…" Command="{Binding OpenFolderCommand}" AutomationProperties.AutomationId="QuickStartWorkspace"/>
       <Button Content="Open document…" Command="{Binding OpenDocumentCommand}" AutomationProperties.AutomationId="QuickStartDocument"/>
       <Button Content="Native guide (F1)" Click="OpenHelp" AutomationProperties.AutomationId="QuickStartHelp"/></WrapPanel>
     </StackPanel>
    </Border>
    <Grid x:Name="ContentGrid">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="*"/><ColumnDefinition x:Name="SplitColumn" Width="5"/><ColumnDefinition x:Name="PreviewColumn" Width="*"/><ColumnDefinition x:Name="OutlineSplitterColumn" Width="5"/><ColumnDefinition x:Name="OutlineColumn" Width="240"/></Grid.ColumnDefinitions>
     <DockPanel x:Name="EditorPane" Grid.Column="0">
      <ToolBar x:Name="FormattingToolbar" DockPanel.Dock="Top" Style="{StaticResource Desktop.EditorToolbar}" AutomationProperties.Name="Markdown formatting">
<Button ToolTip="Heading level" AutomationProperties.Name="Heading level" Click="OpenHeadingMenu"><ui:CommandIcon Kind="Heading"/></Button>
     <Button Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo (Ctrl+Z)"><ui:CommandIcon Kind="Undo"/></Button>
     <Button Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo (Ctrl+Y)"><ui:CommandIcon Kind="Redo"/></Button>
<Separator/>
     <Button Tag="bold" Click="Format" ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold (Ctrl+B)" AutomationProperties.AutomationId="FormatBold"><ui:CommandIcon Kind="Bold"/></Button>
     <Button Tag="italic" Click="Format" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic (Ctrl+I)" AutomationProperties.AutomationId="FormatItalic"><ui:CommandIcon Kind="Italic"/></Button>
     <Button Tag="strike" Click="Format" ToolTip="Strikethrough" AutomationProperties.Name="Strikethrough" AutomationProperties.AutomationId="FormatStrike"><ui:CommandIcon Kind="Strike"/></Button>
     <Button Tag="inline-code" Click="Format" ToolTip="Inline code" AutomationProperties.Name="Inline code" AutomationProperties.AutomationId="FormatCode"><ui:CommandIcon Kind="Code"/></Button>
     <Button Tag="link" Click="Format" ToolTip="Insert link" AutomationProperties.Name="Insert link" AutomationProperties.AutomationId="FormatLink"><ui:CommandIcon Kind="Link"/></Button>
     <Button Click="InsertDocumentLink" ToolTip="Workspace document link (Ctrl+Shift+K)" AutomationProperties.Name="Workspace document link (Ctrl+Shift+K)" AutomationProperties.AutomationId="FormatDocumentLink"><ui:CommandIcon Kind="Document"/></Button>
     <Button Click="InsertImage" ToolTip="Insert local image" AutomationProperties.Name="Insert local image" AutomationProperties.AutomationId="FormatImage"><ui:CommandIcon Kind="Image"/></Button>
<Separator/>
     <Button Tag="bullet" Click="Format" ToolTip="Bullet list" AutomationProperties.Name="Bullet list" AutomationProperties.AutomationId="Formatbullet"><ui:CommandIcon Kind="Bullet"/></Button>
     <Button Tag="numbered" Click="Format" ToolTip="Numbered list" AutomationProperties.Name="Numbered list" AutomationProperties.AutomationId="Formatnumbered"><ui:CommandIcon Kind="Numbered"/></Button>
     <Button Tag="task" Click="Format" ToolTip="Checklist" AutomationProperties.Name="Checklist" AutomationProperties.AutomationId="Formattask"><ui:CommandIcon Kind="Checklist"/></Button>
     <Button Tag="quote" Click="Format" ToolTip="Quote" AutomationProperties.Name="Quote" AutomationProperties.AutomationId="Formatquote"><ui:CommandIcon Kind="Quote"/></Button>
     <Button Tag="code" Click="Format" ToolTip="Code block" AutomationProperties.Name="Code block" AutomationProperties.AutomationId="Formatcode"><ui:CommandIcon Kind="Code"/></Button>
     <Button Tag="mermaid" Click="Format" ToolTip="Mermaid block" AutomationProperties.Name="Mermaid block" AutomationProperties.AutomationId="Formatmermaid"><ui:CommandIcon Kind="Mermaid"/></Button>
     <Button Tag="table" Click="Format" ToolTip="Table" AutomationProperties.Name="Table" AutomationProperties.AutomationId="Formattable"><ui:CommandIcon Kind="Table"/></Button>
     <Button Tag="rule" Click="Format" ToolTip="Horizontal rule" AutomationProperties.Name="Horizontal rule" AutomationProperties.AutomationId="Formatrule"><ui:CommandIcon Kind="Rule"/></Button>
      </ToolBar>
     <ui:MarkdownEditor x:Name="Editor" ShowLineNumbers="True" FontFamily="Cascadia Code, Consolas" FontSize="14"
        IsReadOnly="{Binding ActiveDocument.IsSaving}"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" Padding="14" BorderThickness="0"
        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" WordWrap="True"
        AllowDrop="True" PreviewDragOver="EditorDragOver" PreviewDrop="EditorDrop"
        GotKeyboardFocus="EditorFocused" AutomationProperties.Name="Markdown editor" AutomationProperties.AutomationId="MarkdownEditor">
      <ui:MarkdownEditor.ContextMenu>
       <ContextMenu AutomationProperties.Name="Editor actions" Opened="PrepareEditorContext">
        <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" AutomationProperties.AutomationId="EditorContextUndo"/>
        <MenuItem Header="_Redo" Command="ApplicationCommands.Redo"/>
        <Separator/>
        <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" AutomationProperties.AutomationId="EditorContextCut"/>
        <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" AutomationProperties.AutomationId="EditorContextCopy"/>
        <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" AutomationProperties.AutomationId="EditorContextPaste"/>
        <MenuItem Header="Select _all" Command="ApplicationCommands.SelectAll"/>
        <Separator/>
        <MenuItem Header="_Bold" Tag="bold" Click="Format" AutomationProperties.AutomationId="EditorContextBold"/>
        <MenuItem Header="_Italic" Tag="italic" Click="Format"/>
        <MenuItem Header="Document _link…" Click="InsertDocumentLink"/>
        <MenuItem Header="Edit or insert _table…" Click="EditTable" AutomationProperties.AutomationId="EditorContextTable"/>
       </ContextMenu>
      </ui:MarkdownEditor.ContextMenu>
     </ui:MarkdownEditor>
     </DockPanel>
     <GridSplitter x:Name="EditorSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
     <DockPanel x:Name="PreviewPane" Grid.Column="2">
      <ToolBar x:Name="PreviewToolbar" DockPanel.Dock="Top" Style="{StaticResource Desktop.Toolbar}" AutomationProperties.Name="Preview commands">
       <ComboBox x:Name="ReadingModeControl" Width="120" SelectionChanged="ReadingModeChanged" ToolTip="Preview reading mode" AutomationProperties.Name="Preview reading mode" AutomationProperties.AutomationId="PreviewReadingMode"/>
       <Button Tag="out" Click="PreviewZoomChanged" ToolTip="Zoom out" AutomationProperties.Name="Zoom out"><ui:CommandIcon Kind="ZoomOut"/></Button>
       <Button Tag="in" Click="PreviewZoomChanged" ToolTip="Zoom in" AutomationProperties.Name="Zoom in"><ui:CommandIcon Kind="ZoomIn"/></Button>
       <CheckBox x:Name="FollowCaretControl" Style="{StaticResource Desktop.ToolbarCheckBox}" Tag="caret" Checked="SyncPreferenceChanged" Unchecked="SyncPreferenceChanged" ToolTip="Follow the editor caret in the preview" AutomationProperties.Name="Follow caret" AutomationProperties.AutomationId="FollowCaretControl"><ui:CommandIcon Kind="Focus"/></CheckBox>
       <CheckBox x:Name="SyncScrollControl" Style="{StaticResource Desktop.ToolbarCheckBox}" Tag="scroll" Checked="SyncPreferenceChanged" Unchecked="SyncPreferenceChanged" ToolTip="Synchronise source regions when either pane scrolls" AutomationProperties.Name="Synchronise scroll" AutomationProperties.AutomationId="SyncScrollControl"><ui:CommandIcon Kind="Sync"/></CheckBox>
       <CheckBox x:Name="SyncSelectionControl" Style="{StaticResource Desktop.ToolbarCheckBox}" Tag="selection" Checked="SyncPreferenceChanged" Unchecked="SyncPreferenceChanged" ToolTip="Synchronise literal text selection in both directions" AutomationProperties.Name="Synchronise selection" AutomationProperties.AutomationId="SyncSelectionControl"><ui:CommandIcon Kind="Selection"/></CheckBox>
       <Button Click="ToggleOutline" ToolTip="Toggle outline (Ctrl+Alt+O)" AutomationProperties.Name="Toggle outline"><ui:CommandIcon Kind="Outline"/></Button>
       <Button Click="FindPreviewFromToolbar" ToolTip="Find in preview" AutomationProperties.Name="Find in preview"><ui:CommandIcon Kind="Search"/></Button>
       <Button Click="CopyRenderedContent" ToolTip="Copy rendered content" AutomationProperties.Name="Copy rendered content"><ui:CommandIcon Kind="Document"/></Button>
      </ToolBar>
      <AdornerDecorator>
     <rendering:DocumentPreview x:Name="Preview" Style="{StaticResource DocumentPreviewStyle}"
       Background="{DynamicResource WindowBrush}" GotKeyboardFocus="PreviewFocused" PreviewMouseDown="OnPreviewMouseDown"
       AutomationProperties.Name="Document preview" AutomationProperties.AutomationId="DocumentPreview"/>
      </AdornerDecorator>
     </DockPanel>
     <GridSplitter x:Name="OutlineSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" DragCompleted="PanelResized" AutomationProperties.Name="Resize outline"/>
     <DockPanel x:Name="OutlinePanel" Grid.Column="4" Background="{DynamicResource PanelBrush}">
      <TextBlock DockPanel.Dock="Top" Text="ON THIS PAGE" FontSize="11" FontWeight="SemiBold" Margin="12,16,5,10"/>
      <ToolBar x:Name="OutlineToolbar" DockPanel.Dock="Top" Style="{StaticResource Desktop.Toolbar}" AutomationProperties.Name="Outline groups">
       <Button Click="ExpandOutlineGroups" ToolTip="Expand all heading groups" AutomationProperties.Name="Expand all heading groups"><ui:CommandIcon Kind="Expand"/></Button>
       <Button Click="CollapseOutlineGroups" ToolTip="Collapse all heading groups" AutomationProperties.Name="Collapse all heading groups"><ui:CommandIcon Kind="Collapse"/></Button>
      </ToolBar>
      <Grid DockPanel.Dock="Top" Margin="10,0,10,10">
       <TextBox x:Name="OutlineFilter" Padding="6" TextChanged="OutlineFilterChanged" ToolTip="Filter document headings" AutomationProperties.Name="Filter document headings"/>
       <TextBlock Text="Filter headings…" DataContext="{Binding ElementName=OutlineFilter}" Style="{StaticResource Desktop.FilterHint}"/>
      </Grid>
      <Grid><ListBox x:Name="Outline" BorderThickness="0" Background="Transparent" SelectionChanged="OutlineSelected" KeyDown="OutlineKeyDown"
       AutomationProperties.Name="Document outline">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource Desktop.SelectionItem}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" Margin="{Binding Level, Converter={StaticResource HeadingIndent}}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
       <TextBlock TextWrapping="Wrap" Margin="14,10" VerticalAlignment="Top" Foreground="{DynamicResource MutedTextBrush}">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Text" Value="No headings match this filter."/><Style.Triggers>
         <DataTrigger Binding="{Binding HasItems, ElementName=Outline}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
         <DataTrigger Binding="{Binding Text, ElementName=OutlineFilter}" Value=""><Setter Property="Text" Value="Add Markdown headings to navigate this document."/></DataTrigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
     </DockPanel>
    </Grid>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>

