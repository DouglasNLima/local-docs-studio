<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>LensDocsStudio.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <RepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..\..\..'))</RepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(RepositoryRoot)index.html" Link="StaticApp\index.html" CopyToOutputDirectory="PreserveNewest" TargetPath="StaticApp\index.html" />
    <Content Include="$(RepositoryRoot)md-mmd-renderer-v5.html" Link="StaticApp\md-mmd-renderer-v5.html" CopyToOutputDirectory="PreserveNewest" TargetPath="StaticApp\md-mmd-renderer-v5.html" />
    <Content Include="$(RepositoryRoot)manifest.webmanifest" Link="StaticApp\manifest.webmanifest" CopyToOutputDirectory="PreserveNewest" TargetPath="StaticApp\manifest.webmanifest" />
    <Content Include="$(RepositoryRoot)icon.svg" Link="StaticApp\icon.svg" CopyToOutputDirectory="PreserveNewest" TargetPath="StaticApp\icon.svg" />
    <Content Include="$(RepositoryRoot)service-worker.js" Link="StaticApp\service-worker.js" CopyToOutputDirectory="PreserveNewest" TargetPath="StaticApp\service-worker.js" />
    <Content Include="$(RepositoryRoot)assets\**\*" Link="StaticApp\assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" TargetPath="StaticApp\assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(RepositoryRoot)docs\**\*" Link="StaticApp\docs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" TargetPath="StaticApp\docs\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
